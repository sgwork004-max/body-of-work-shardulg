  "nodes": {
    "var_94544f82b625": {
      "type": "variant",
      "label": "Nocturnal Tech-Explorer",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Italiana&family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Manrope:wght@300;400;500&family=Space+Mono:wght@400&display=swap');\n\n  :root {\n    --bg-primary: #050505;\n    --bg-secondary: #111111;\n    --text-primary: #F7F7F7;\n    --text-muted: #888888;\n    --accent-1: #FFD700;\n    --accent-2: #FF8C00;\n    --surface-mid: #1A1A1A;\n    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  body {\n    background: var(--bg-primary);\n    color: var(--text-primary);\n    font-family: 'Manrope', sans-serif;\n    font-weight: 300;\n    line-height: 1.6;\n    overflow-x: hidden;\n    margin: 0;\n  }\n\n  /* --- NAV --- */\n  #main-nav {\n    position: fixed;\n    top: 0; left: 0; right: 0;\n    z-index: 100;\n    padding: 24px 0;\n    transition: background 400ms ease, padding 400ms ease;\n  }\n  #main-nav.scrolled {\n    background: rgba(5, 5, 5, 0.94);\n    backdrop-filter: blur(14px);\n    -webkit-backdrop-filter: blur(14px);\n    padding: 16px 0;\n  }\n  .nav-inner {\n    max-width: 1440px;\n    margin: 0 auto;\n    padding: 0 6vw;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n  }\n  .nav-logo {\n    font-family: 'Italiana', serif;\n    font-weight: 400;\n    font-size: 22px;\n    letter-spacing: 0.06em;\n    color: var(--text-primary);\n    text-decoration: none;\n  }\n  .nav-links {\n    display: flex;\n    align-items: center;\n    gap: 36px;\n  }\n  .nav-links a {\n    color: var(--text-primary);\n    text-decoration: none;\n    font-family: 'Space Mono', monospace;\n    font-size: 10px;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    opacity: 0.75;\n    transition: opacity 200ms;\n  }\n  .nav-links a:hover { opacity: 1; }\n  .nav-links .nav-cta {\n    background: var(--accent-1);\n    color: var(--bg-primary);\n    padding: 8px 20px;\n    opacity: 1;\n    font-weight: 600;\n  }\n\n  /* --- HERO --- */\n  .hero {\n    position: relative;\n    width: 100%;\n    height: 100vh;\n    min-height: 600px;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    background: var(--bg-primary);\n  }\n  #hero-video {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n  .hero-overlay {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(to bottom,\n      rgba(5, 5, 5, 0.6) 0%,\n      rgba(5, 5, 5, 0.3) 35%,\n      rgba(5, 5, 5, 0.3) 65%,\n      rgba(5, 5, 5, 0.7) 100%);\n  }\n  .constellation {\n    position: absolute;\n    top: 6%;\n    left: 4%;\n    width: 36vw;\n    max-width: 520px;\n    height: auto;\n    opacity: 0.40;\n    pointer-events: none;\n    z-index: 1;\n    animation: slowRotate 120s linear infinite;\n  }\n  @keyframes slowRotate {\n    to { transform: rotate(360deg); }\n  }\n  .hero-rail {\n    position: absolute;\n    right: 0;\n    top: 0;\n    bottom: 0;\n    width: 28px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 3;\n    pointer-events: none;\n  }\n  .hero-rail span {\n    display: block;\n    font-family: 'Space Mono', monospace;\n    font-size: 9px;\n    letter-spacing: 0.24em;\n    text-transform: uppercase;\n    color: var(--text-muted);\n    opacity: 0.60;\n    white-space: nowrap;\n    transform: rotate(90deg);\n  }\n  .hero-content {\n    position: relative;\n    z-index: 2;\n    text-align: right;\n    padding: 0 7vw 0 0;\n    max-width: 54%;\n  }\n  .hero-eyebrow {\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    gap: 10px;\n    font-family: 'Space Mono', monospace;\n    font-size: 10px;\n    letter-spacing: 0.20em;\n    text-transform: uppercase;\n    color: var(--accent-1);\n    margin-bottom: 28px;\n  }\n  .hero-eyebrow::before { content: '✦'; font-size: 8px; }\n  .hero-headline {\n    font-family: 'Italiana', serif;\n    font-weight: 400;\n    font-size: clamp(32px, 4.5vw, 64px);\n    line-height: 1.05;\n    letter-spacing: 0.04em;\n    color: var(--text-primary);\n    margin-bottom: 28px;\n    position: relative;\n    overflow: hidden;\n  }\n  .hero-headline::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: var(--bg-primary);\n    transform: scaleX(1);\n    transform-origin: right;\n    transition: transform 1200ms var(--ease-expo);\n  }\n  .hero-headline.is-in::after { transform: scaleX(0); }\n  .hero-headline .glow {\n    color: var(--accent-1);\n    text-shadow: 0 0 30px rgba(255, 215, 0, 0.4);\n  }\n  .hero-rule {\n    width: 60px;\n    height: 1px;\n    background: var(--accent-1);\n    margin: 0 0 28px auto;\n  }\n  .hero-sub {\n    font-size: 16px;\n    color: var(--text-primary);\n    opacity: 0.70;\n    margin-bottom: 36px;\n    max-width: 400px;\n    margin-left: auto;\n  }\n  .hero-cta {\n    display: inline-block;\n    background: var(--accent-1);\n    color: var(--bg-primary);\n    font-family: 'Space Mono', monospace;\n    font-size: 11px;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    padding: 16px 32px;\n    text-decoration: none;\n    font-weight: 700;\n    transition: background 200ms, transform 200ms;\n  }\n  .hero-cta:hover { background: #ffea00; transform: translateY(-2px); }\n\n  /* --- SECTION 1: ROUTES --- */\n  .routes {\n    position: relative;\n    background: var(--bg-secondary);\n    overflow: hidden;\n    min-height: 100vh;\n    display: flex;\n    align-items: center;\n  }\n  .routes-bg-base {\n    position: absolute;\n    inset: 0;\n    background: var(--bg-secondary);\n  }\n  .routes-bg-base img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    opacity: 0.2;\n    filter: grayscale(100%);\n  }\n  .routes-bg-reveal {\n    position: absolute;\n    inset: 0;\n    background: var(--bg-secondary);\n    -webkit-mask-image: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), black 180px, transparent 280px);\n    mask-image: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), black 180px, transparent 280px);\n  }\n  .routes-bg-reveal img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    opacity: 0.8;\n  }\n  .routes-content {\n    position: relative;\n    z-index: 5;\n    padding: 120px 6vw;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 80px;\n    max-width: 1440px;\n    margin: 0 auto;\n    align-items: center;\n  }\n  .section-eyebrow {\n    font-family: 'Space Mono', monospace;\n    font-size: 10px;\n    letter-spacing: 0.20em;\n    text-transform: uppercase;\n    color: var(--accent-1);\n    margin-bottom: 24px;\n  }\n  .routes-headline {\n    font-family: 'Fraunces', serif;\n    font-weight: 900;\n    font-style: italic;\n    font-variation-settings: 'SOFT' 100, 'opsz' 144;\n    font-size: clamp(40px, 5vw, 72px);\n    line-height: 1.05;\n    margin-bottom: 28px;\n    opacity: 0;\n    transform: translateY(30px) skewY(5deg);\n    transition: opacity 800ms var(--ease-expo), transform 800ms var(--ease-expo);\n  }\n  .routes-headline.is-in { opacity: 1; transform: translateY(0) skewY(0deg); }\n  .routes-body {\n    font-size: 16px;\n    color: var(--text-muted);\n    margin-bottom: 40px;\n    max-width: 420px;\n  }\n  .route-card {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 24px;\n    border-top: 1px solid rgba(255, 255, 255, 0.1);\n    border-left: 3px solid var(--accent-1);\n    cursor: pointer;\n    background: rgba(255, 215, 0, 0.02);\n    transition: background 300ms ease;\n  }\n  .route-card:hover { background: rgba(255, 215, 0, 0.08); }\n  .route-name {\n    font-family: 'Fraunces', serif;\n    font-weight: 700;\n    font-style: italic;\n    font-size: 24px;\n    margin-bottom: 4px;\n  }\n  .route-region {\n    font-family: 'Space Mono', monospace;\n    font-size: 10px;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n    color: var(--text-muted);\n  }\n  .route-arrow { font-size: 20px; color: var(--accent-1); }\n\n  /* --- SECTION 2: VOICES --- */\n  .voices {\n    background: var(--surface-mid);\n    padding: 160px 6vw;\n    text-align: center;\n  }\n  .word-mask-headline {\n    font-family: 'Fraunces', serif;\n    font-weight: 900;\n    font-style: italic;\n    font-variation-settings: 'SOFT' 100, 'opsz' 144;\n    font-size: clamp(48px, 8vw, 96px);\n    line-height: 1.1;\n    margin-bottom: 100px;\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 0.25em;\n  }\n  .wmw {\n    color: var(--text-muted);\n    transition: color 600ms var(--ease-expo);\n  }\n  .wmw.filled {\n    color: var(--accent-1);\n    background: linear-gradient(135deg, var(--accent-1) 30%, #FFF 80%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n  .voice-block {\n    margin-bottom: 80px;\n    opacity: 0;\n    transform: translateY(30px);\n    transition: opacity 1000ms var(--ease-expo), transform 1000ms var(--ease-expo);\n  }\n  .voice-block.is-in { opacity: 1; transform: translateY(0); }\n  .voice-quote-primary {\n    font-family: 'Fraunces', serif;\n    font-weight: 700;\n    font-style: italic;\n    font-size: clamp(28px, 3.5vw, 44px);\n    color: var(--accent-1);\n    margin-bottom: 20px;\n  }\n  .voice-cite {\n    font-family: 'Space Mono', monospace;\n    font-size: 11px;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n    color: var(--text-muted);\n  }\n\n  /* --- SECTION 3: CROSSINGS --- */\n  .crossings {\n    padding: 160px 6vw;\n    background: var(--bg-primary);\n  }\n  .crossings-headline {\n    font-family: 'Fraunces', serif;\n    font-weight: 900;\n    font-style: italic;\n    font-size: clamp(40px, 6vw, 80px);\n    margin-bottom: 80px;\n    opacity: 0;\n    letter-spacing: 0.3em;\n    transition: letter-spacing 1200ms var(--ease-expo), opacity 1000ms var(--ease-expo);\n  }\n  .crossings-headline.is-in { opacity: 1; letter-spacing: 0.02em; }\n\n  .crossing-grid {\n    display: grid;\n    grid-template-columns: 44fr 32fr 24fr;\n    gap: 40px;\n    perspective: 2000px;\n    max-width: 1440px;\n    margin: 0 auto;\n  }\n  .crossing-card {\n    will-change: transform;\n    transform-style: preserve-3d;\n    transition: transform 100ms linear;\n  }\n  .card-2 { margin-top: 100px; border: 1px solid var(--accent-2); padding: 40px; background: var(--bg-secondary); }\n  .card-3 { margin-top: 200px; }\n  .crossing-card img { width: 100%; display: block; object-fit: cover; }\n  .card-1 img { aspect-ratio: 2/3; }\n  .card-3 img { aspect-ratio: 3/4; }\n  .crossing-card-body { padding-top: 32px; }\n  .crossing-coords {\n    font-family: 'Space Mono', monospace;\n    font-size: 10px;\n    color: var(--accent-1);\n    margin-bottom: 16px;\n    letter-spacing: 0.2em;\n  }\n  .crossing-title {\n    font-family: 'Fraunces', serif;\n    font-weight: 700;\n    font-style: italic;\n    font-size: 28px;\n    margin-bottom: 16px;\n  }\n\n  /* --- FOOTER --- */\n  footer {\n    padding: 100px 6vw 80px;\n    background: #000;\n    border-top: 1px solid var(--accent-1);\n  }\n  .footer-inner {\n    display: grid;\n    grid-template-columns: 1.5fr 1fr 1fr;\n    gap: 60px;\n    max-width: 1440px;\n    margin: 0 auto;\n  }\n  .footer-logo {\n    font-family: 'Italiana', serif;\n    font-size: 80px;\n    color: var(--text-primary);\n    text-decoration: none;\n    line-height: 0.9;\n  }\n  .footer-col-label {\n    font-family: 'Space Mono', monospace;\n    font-size: 10px;\n    color: var(--accent-1);\n    margin-bottom: 24px;\n    text-transform: uppercase;\n  }\n  .footer-links { list-style: none; padding: 0; }\n  .footer-links li { margin-bottom: 12px; }\n  .footer-links a { color: var(--text-muted); text-decoration: none; transition: color 200ms; }\n  .footer-links a:hover { color: var(--accent-1); }\n</style>\n<nav data-kid=\"1\" data-name=\"main navigation header\" id=\"main-nav\">\n    <div class=\"nav-inner\" data-kid=\"1-1\" data-name=\"navigation inner container\">\n        <a class=\"nav-logo\" data-kid=\"1-1-1\" data-name=\"navigation logo link\" href=\"#\">\n            HORIZON\n        </a>\n        <div class=\"nav-links\" data-kid=\"1-1-2\" data-name=\"navigation links container\">\n            <a data-kid=\"1-1-2-1\" data-name=\"expeditions nav link\" href=\"#routes\">\n                Expeditions\n            </a>\n            <a data-kid=\"1-1-2-2\" data-name=\"dispatches nav link\" href=\"#voices\">\n                Dispatches\n            </a>\n            <a data-kid=\"1-1-2-3\" data-name=\"about nav link\" href=\"#\">\n                About\n            </a>\n            <a class=\"nav-cta\" data-kid=\"1-1-2-4\" data-name=\"begin call-to-action button\" href=\"#\">\n                Begin →\n            </a>\n        </div>\n    </div>\n</nav>\n<section class=\"hero\" data-kid=\"2\" data-name=\"hero section\">\n    <video autoplay=\"\" data-kid=\"2-1\" data-name=\"hero video background\" id=\"hero-video\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/13721787/armament-open-air-soldier-special-forces-13721787.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\">\n        <source data-kid=\"2-1-1\" data-name=\"hero background video source\" src=\"https://videos.pexels.com/video-files/13721787/13721787-hd_1920_1080_60fps.mp4\" type=\"video/mp4\"/>\n    </video>\n    <div class=\"hero-overlay\" data-kid=\"2-2\" data-name=\"hero overlay gradient\">\n    </div>\n    <svg class=\"constellation\" data-kid=\"2-3\" data-name=\"rotating constellation svg\" viewbox=\"0 0 500 400\">\n        <circle cx=\"100\" cy=\"100\" fill=\"white\" r=\"2\">\n        </circle>\n        <circle cx=\"150\" cy=\"150\" fill=\"white\" r=\"2\">\n        </circle>\n        <circle cx=\"200\" cy=\"120\" fill=\"white\" r=\"2\">\n        </circle>\n        <circle cx=\"250\" cy=\"180\" fill=\"white\" r=\"2\">\n        </circle>\n        <circle cx=\"180\" cy=\"220\" fill=\"white\" r=\"2\">\n        </circle>\n        <line stroke=\"rgba(255,255,255,0.2)\" x1=\"100\" x2=\"150\" y1=\"100\" y2=\"150\">\n        </line>\n        <line stroke=\"rgba(255,255,255,0.2)\" x1=\"150\" x2=\"200\" y1=\"150\" y2=\"120\">\n        </line>\n        <line stroke=\"rgba(255,255,255,0.2)\" x1=\"200\" x2=\"250\" y1=\"120\" y2=\"180\">\n        </line>\n        <line stroke=\"rgba(255,255,255,0.2)\" x1=\"250\" x2=\"180\" y1=\"180\" y2=\"220\">\n        </line>\n    </svg>\n    <div class=\"hero-rail\" data-kid=\"2-4\" data-name=\"hero rail container\">\n        <span data-kid=\"2-4-1\" data-name=\"hero rail text\">\n            DARK SKY EXPEDITIONS · 64°N · 140°E\n        </span>\n    </div>\n    <div class=\"hero-content\" data-kid=\"2-5\" data-name=\"hero content container\">\n        <div class=\"hero-eyebrow\" data-kid=\"2-5-1\" data-name=\"hero eyebrow text\">\n            Tactical Night Operations\n        </div>\n        <h1 class=\"hero-headline\" data-kid=\"2-5-2\" data-name=\"hero headline text\">\n            Where the\n            <span class=\"glow\" data-kid=\"2-5-2-1\" data-name=\"hero headline glow span\">\n                night\n            </span>\n            goes to work.\n        </h1>\n        <div class=\"hero-rule\" data-kid=\"2-5-3\" data-name=\"hero decorative rule\">\n        </div>\n        <p class=\"hero-sub\" data-kid=\"2-5-4\" data-name=\"hero subheadline text\">\n            Elite wilderness expeditions shaped by darkness, silence, and the spaces between stars.\n        </p>\n        <a class=\"hero-cta\" data-kid=\"2-5-5\" data-name=\"hero call-to-action button\" href=\"#routes\">\n            Begin Your Expedition →\n        </a>\n    </div>\n</section>\n<section class=\"routes\" data-kid=\"3\" data-name=\"routes section\" id=\"routes\">\n    <div class=\"routes-bg-base\" data-kid=\"3-1\" data-name=\"routes background image container\">\n        <img alt=\"Obsidian peaks base\" data-kid=\"3-1-1\" data-name=\"routes base image\" src=\"https://images.unsplash.com/photo-1574610758891-5b809b6e6e2e?auto=format&w=1280&q=80\"/>\n    </div>\n    <div class=\"routes-bg-reveal\" data-dynamic=\"true\" data-kid=\"3-2\" data-name=\"routes spotlight reveal container\" data-reason=\"css variables --mx and --my updated by mousemove on parent section\" id=\"spotlight-layer\">\n        <img alt=\"Obsidian peaks reveal\" data-kid=\"3-2-1\" data-name=\"routes reveal image\" src=\"https://images.unsplash.com/photo-1574610758891-5b809b6e6e2e?auto=format&w=1280&q=80\"/>\n    </div>\n    <div class=\"routes-content\" data-kid=\"3-3\" data-name=\"routes content grid container\">\n        <div class=\"routes-text\" data-kid=\"3-3-1\" data-name=\"routes text content container\">\n            <div class=\"section-eyebrow\" data-kid=\"3-3-1-1\" data-name=\"routes section eyebrow text\">\n                The Expeditions\n            </div>\n            <h2 class=\"routes-headline animate-on-scroll\" data-kid=\"3-3-1-2\" data-name=\"routes section headline text\">\n                Not a tour.\n                <br data-kid=\"3-3-1-2-1\" data-name=\"routes headline line break\"/>\n                Not a package.\n            </h2>\n            <p class=\"routes-body\" data-kid=\"3-3-1-3\" data-name=\"routes section body text\">\n                An expedition shaped around your capacity for wonder. Three continents, one standard: the dark frontier.\n            </p>\n            <a class=\"hero-cta\" data-kid=\"3-3-1-4\" data-name=\"view all call-to-action button\" href=\"#\" style=\"background: transparent; border: 1px solid var(--accent-1); color: var(--accent-1);\">\n                View All →\n            </a>\n        </div>\n        <div class=\"route-cards\" data-kid=\"3-3-2\" data-name=\"route cards container\">\n            <div class=\"route-card\" data-kid=\"3-3-2-1\" data-name=\"route card 1\">\n                <div data-kid=\"3-3-2-1-1\" data-name=\"route card info container\">\n                    <div class=\"route-region\" data-kid=\"3-3-2-1-1-1\" data-name=\"route card region text\">\n                        Iceland\n                    </div>\n                    <div class=\"route-name\" data-kid=\"3-3-2-1-1-2\" data-name=\"route card name text\">\n                        Northern Lights Passage\n                    </div>\n                </div>\n                <div class=\"route-arrow\" data-kid=\"3-3-2-1-2\" data-name=\"route card arrow icon\">\n                    →\n                </div>\n            </div>\n            <div class=\"route-card\" data-kid=\"3-3-2-2\" data-name=\"route card 2\">\n                <div data-kid=\"3-3-2-2-1\" data-name=\"route card info container\">\n                    <div class=\"route-region\" data-kid=\"3-3-2-2-1-1\" data-name=\"route card region text\">\n                        Chile\n                    </div>\n                    <div class=\"route-name\" data-kid=\"3-3-2-2-1-2\" data-name=\"route card name text\">\n                        Atacama Night Trek\n                    </div>\n                </div>\n                <div class=\"route-arrow\" data-kid=\"3-3-2-2-2\" data-name=\"route card arrow icon\">\n                    →\n                </div>\n            </div>\n            <div class=\"route-card\" data-kid=\"3-3-2-3\" data-name=\"route card 3\">\n                <div data-kid=\"3-3-2-3-1\" data-name=\"route card info container\">\n                    <div class=\"route-region\" data-kid=\"3-3-2-3-1-1\" data-name=\"route card region text\">\n                        Namibia\n                    </div>\n                    <div class=\"route-name\" data-kid=\"3-3-2-3-1-2\" data-name=\"route card name text\">\n                        Namibian Dark Sky Reserve\n                    </div>\n                </div>\n                <div class=\"route-arrow\" data-kid=\"3-3-2-3-2\" data-name=\"route card arrow icon\">\n                    →\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n<section class=\"voices\" data-kid=\"4\" data-name=\"voices section\" id=\"voices\">\n    <div class=\"word-mask-headline\" data-kid=\"4-1\" data-name=\"word mask headline container\" id=\"voice-headline\">\n        <span class=\"wmw\" data-dynamic=\"true\" data-kid=\"4-1-1\" data-name=\"word mask word 1\" data-reason=\"filled class toggled by intersection observer\">\n            They\n        </span>\n        <span class=\"wmw\" data-dynamic=\"true\" data-kid=\"4-1-2\" data-name=\"word mask word 2\" data-reason=\"filled class toggled by intersection observer\">\n            chose\n        </span>\n        <span class=\"wmw\" data-dynamic=\"true\" data-kid=\"4-1-3\" data-name=\"word mask word 3\" data-reason=\"filled class toggled by intersection observer\">\n            the\n        </span>\n        <span class=\"wmw\" data-dynamic=\"true\" data-kid=\"4-1-4\" data-name=\"word mask word 4\" data-reason=\"filled class toggled by intersection observer\">\n            dark.\n        </span>\n    </div>\n    <div class=\"voice-block animate-on-scroll\" data-kid=\"4-2\" data-name=\"voice block 1\">\n        <div class=\"voice-quote-primary\" data-kid=\"4-2-1\" data-name=\"voice quote primary text\">\n            \"The sky reminded me I was nowhere near home.\"\n        </div>\n        <div class=\"voice-cite\" data-kid=\"4-2-2\" data-name=\"voice citation text\">\n            — Mara K., Iceland Expedition 2024\n        </div>\n    </div>\n    <div class=\"voice-block animate-on-scroll\" data-kid=\"4-3\" data-name=\"voice block 2\" style=\"margin-left: auto; text-align: right; max-width: 600px;\">\n        <div class=\"voice-quote-primary\" data-kid=\"4-3-1\" data-name=\"voice quote primary text\">\n            \"Fourteen nights. Zero regrets.\"\n        </div>\n        <div class=\"voice-cite\" data-kid=\"4-3-2\" data-name=\"voice citation text\">\n            — James O., Atacama Night Trek 2023\n        </div>\n    </div>\n</section>\n<section class=\"crossings\" data-kid=\"5\" data-name=\"crossings section\">\n    <div class=\"section-eyebrow\" data-kid=\"5-1\" data-name=\"crossings section eyebrow text\">\n        Field Dispatches\n    </div>\n    <h2 class=\"crossings-headline animate-on-scroll\" data-kid=\"5-2\" data-name=\"crossings headline text\">\n        Three crossings. One standard.\n    </h2>\n    <div class=\"crossing-grid\" data-kid=\"5-3\" data-name=\"crossing grid container\">\n        <div class=\"crossing-card card-1 animate-on-scroll\" data-dynamic=\"true\" data-kid=\"5-3-1\" data-name=\"crossing card 1\" data-reason=\"transform property reinitialized by mousemove script\">\n            <img alt=\"Night hiker\" data-kid=\"5-3-1-1\" data-name=\"crossing card image\" src=\"https://images.unsplash.com/photo-1630275383125-2ecfa5f431d5?auto=format&w=800&q=80\"/>\n            <div class=\"crossing-card-body\" data-kid=\"5-3-1-2\" data-name=\"crossing card body container\">\n                <div class=\"crossing-coords\" data-kid=\"5-3-1-2-1\" data-name=\"crossing coordinates text\">\n                    64°21′S · 30°14′W\n                </div>\n                <div class=\"crossing-title\" data-kid=\"5-3-1-2-2\" data-name=\"crossing title text\">\n                    The Bolivian Meridian\n                </div>\n                <p class=\"routes-body\" data-kid=\"5-3-1-2-3\" data-name=\"crossing description text\">\n                    Twelve days on the world's largest mirror. The salt reflects every star above.\n                </p>\n            </div>\n        </div>\n        <div class=\"crossing-card card-2 animate-on-scroll\" data-dynamic=\"true\" data-kid=\"5-3-2\" data-name=\"crossing card 2\" data-reason=\"transform property reinitialized by mousemove script\">\n            <div class=\"crossing-card-body\" data-kid=\"5-3-2-1\" data-name=\"crossing card body container\">\n                <div class=\"crossing-coords\" data-kid=\"5-3-2-1-1\" data-name=\"crossing coordinates text\">\n                    23°52′S · 69°01′W\n                </div>\n                <div class=\"crossing-title\" data-kid=\"5-3-2-1-2\" data-name=\"crossing title text\">\n                    Atacama: Where the Sky Begins\n                </div>\n                <p class=\"routes-body\" data-kid=\"5-3-2-1-3\" data-name=\"crossing description text\">\n                    At 5,000 metres, you stop trying to name what you see and start listening.\n                </p>\n            </div>\n        </div>\n        <div class=\"crossing-card card-3 animate-on-scroll\" data-dynamic=\"true\" data-kid=\"5-3-3\" data-name=\"crossing card 3\" data-reason=\"transform property reinitialized by mousemove script\">\n            <img alt=\"Basecamp\" data-kid=\"5-3-3-1\" data-name=\"crossing card image\" src=\"https://images.unsplash.com/photo-1673356993319-4ed0dea9e9b6?auto=format&w=800&q=80\"/>\n            <div class=\"crossing-card-body\" data-kid=\"5-3-3-2\" data-name=\"crossing card body container\">\n                <div class=\"crossing-coords\" data-kid=\"5-3-3-2-1\" data-name=\"crossing coordinates text\">\n                    41°50′N · 79°11′E\n                </div>\n                <div class=\"crossing-title\" data-kid=\"5-3-3-2-2\" data-name=\"crossing title text\">\n                    Tian Shan Night Watch\n                </div>\n                <p class=\"routes-body\" data-kid=\"5-3-3-2-3\" data-name=\"crossing description text\">\n                    Eleven nights at high altitude. Unfiltered sky above, silence below.\n                </p>\n            </div>\n        </div>\n    </div>\n</section>\n<footer data-kid=\"6\" data-name=\"footer section\">\n    <div class=\"footer-inner\" data-kid=\"6-1\" data-name=\"footer inner grid container\">\n        <a class=\"footer-logo\" data-kid=\"6-1-1\" data-name=\"footer logo link\" href=\"#\">\n            HORIZON\n        </a>\n        <div data-kid=\"6-1-2\" data-name=\"footer expedition column container\">\n            <div class=\"footer-col-label\" data-kid=\"6-1-2-1\" data-name=\"footer column label text\">\n                Expeditions\n            </div>\n            <ul class=\"footer-links\" data-kid=\"6-1-2-2\" data-name=\"footer expedition links list\">\n                <li data-kid=\"6-1-2-2-1\" data-name=\"footer link list item 1\">\n                    <a data-kid=\"6-1-2-2-1-1\" data-name=\"footer link 1\" href=\"#\">\n                        Northern Lights\n                    </a>\n                </li>\n                <li data-kid=\"6-1-2-2-2\" data-name=\"footer link list item 2\">\n                    <a data-kid=\"6-1-2-2-2-1\" data-name=\"footer link 2\" href=\"#\">\n                        Atacama Trek\n                    </a>\n                </li>\n                <li data-kid=\"6-1-2-2-3\" data-name=\"footer link list item 3\">\n                    <a data-kid=\"6-1-2-2-3-1\" data-name=\"footer link 3\" href=\"#\">\n                        Namibian Reserve\n                    </a>\n                </li>\n                <li data-kid=\"6-1-2-2-4\" data-name=\"footer link list item 4\">\n                    <a data-kid=\"6-1-2-2-4-1\" data-name=\"footer link 4\" href=\"#\">\n                        Tian Shan Watch\n                    </a>\n                </li>\n            </ul>\n        </div>\n        <div data-kid=\"6-1-3\" data-name=\"footer cta container\" style=\"border: 1px solid var(--accent-1); padding: 30px;\">\n            <p data-kid=\"6-1-3-1\" data-name=\"footer cta headline text\" style=\"font-family: 'Fraunces', serif; font-size: 20px; font-style: italic; margin-bottom: 20px;\">\n                Ready to go somewhere maps don't show?\n            </p>\n            <a class=\"hero-cta\" data-kid=\"6-1-3-2\" data-name=\"footer call-to-action button\" href=\"#\">\n                Begin Your Expedition →\n            </a>\n        </div>\n    </div>\n</footer>\n<script>\n    // Nav scroll\n  window.addEventListener('scroll', () => {\n    document.getElementById('main-nav').classList.toggle('scrolled', window.scrollY > 50);\n  });\n\n  // Hero reveal\n  setTimeout(() => {\n    document.querySelector('.hero-headline').classList.add('is-in');\n  }, 500);\n\n  // Spotlight reveal\n  const spotlightSection = document.querySelector('.routes');\n  const spotlightLayer = document.getElementById('spotlight-layer');\n  spotlightSection.addEventListener('mousemove', (e) => {\n    const rect = spotlightSection.getBoundingClientRect();\n    const x = ((e.clientX - rect.left) / rect.width) * 100;\n    const y = ((e.clientY - rect.top) / rect.height) * 100;\n    spotlightLayer.style.setProperty('--mx', x + '%');\n    spotlightLayer.style.setProperty('--my', y + '%');\n  });\n\n  // Word mask fill on scroll\n  const words = document.querySelectorAll('.wmw');\n  const observerOptions = { threshold: 0.5 };\n  const observer = new IntersectionObserver((entries) => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        entry.target.classList.add('filled');\n      }\n    });\n  }, observerOptions);\n  words.forEach(word => observer.observe(word));\n\n  // Generic animate on scroll\n  const scrollAnimate = new IntersectionObserver((entries) => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        entry.target.classList.add('is-in');\n      }\n    });\n  }, { threshold: 0.1 });\n  document.querySelectorAll('.animate-on-scroll').forEach(el => scrollAnimate.observe(el));\n\n  // 3D Tilt Cards\n  document.querySelectorAll('.crossing-card').forEach(card => {\n    card.addEventListener('mousemove', (e) => {\n      const rect = card.getBoundingClientRect();\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n      const centerX = rect.width / 2;\n      const centerY = rect.height / 2;\n      const rotateX = (centerY - y) / 15;\n      const rotateY = (x - centerX) / 15;\n      card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(20px)`;\n    });\n    card.addEventListener('mouseleave', () => {\n      card.style.transform = `perspective(1000px) rotateX(0) rotateY(0) translateZ(0)`;\n    });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-07-23T05:38:01.631528+00:00",
      "modified": "2026-07-23T05:38:46.272836+00:00",
      "id": "var_94544f82b625"
    },
    "var_e0675ffc4101": {
      "type": "variant",
      "label": "Warm Amber Dusk",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Italiana&family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Manrope:wght@300;400;500&family=Space+Mono:wght@400&display=swap');\n\n  :root {\n    --bg-primary: #2A1B14;\n    --bg-secondary: #3E271D;\n    --text-primary: #F5EAE1;\n    --text-muted: #A89285;\n    --accent-1: #D98C40;\n    --accent-2: #C06030;\n    --surface-mid: #4D3325;\n    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  html { scroll-behavior: smooth; }\n\n  body {\n    background: var(--bg-primary);\n    color: var(--text-primary);\n    font-family: 'Manrope', sans-serif;\n    font-weight: 300;\n    line-height: 1.6;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  /* ─── NAV ─────────────────────────────────────────────── */\n\n  #main-nav {\n    position: fixed;\n    top: 0; left: 0; right: 0;\n    z-index: 100;\n    padding: 24px 0;\n    transition: background 400ms ease, padding 400ms ease;\n  }\n  #main-nav.scrolled {\n    background: rgba(42, 27, 20, 0.94);\n    backdrop-filter: blur(14px);\n    -webkit-backdrop-filter: blur(14px);\n    padding: 16px 0;\n  }\n  .nav-inner {\n    max-width: 1440px;\n    margin: 0 auto;\n    padding: 0 6vw;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n  }\n  .nav-logo {\n    font-family: 'Italiana', serif;\n    font-weight: 400;\n    font-size: 22px;\n    letter-spacing: 0.06em;\n    color: var(--text-primary);\n    text-decoration: none;\n  }\n  .nav-links {\n    display: flex;\n    align-items: center;\n    gap: 36px;\n  }\n  .nav-links a {\n    color: var(--text-primary);\n    text-decoration: none;\n    font-family: 'Space Mono', monospace;\n    font-size: 10px;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    opacity: 0.75;\n    transition: opacity 200ms;\n  }\n  .nav-links a:hover { opacity: 1; }\n  .nav-links .nav-cta {\n    background: var(--accent-1);\n    color: var(--bg-primary);\n    padding: 8px 20px;\n    opacity: 1;\n    font-weight: 600;\n  }\n  .nav-links .nav-cta:hover { background: #e6a05d; }\n\n  /* ─── HERO ────────────────────────────────────────────── */\n\n  .hero {\n    position: relative;\n    width: 100%;\n    height: 100vh;\n    min-height: 600px;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    background: var(--bg-primary);\n  }\n  #hero-video {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n  .hero-overlay {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(to bottom,\n      rgba(42,27,20,0.45) 0%,\n      rgba(42,27,20,0.18) 35%,\n      rgba(42,27,20,0.18) 65%,\n      rgba(42,27,20,0.50) 100%);\n  }\n  .constellation {\n    position: absolute;\n    top: 6%;\n    left: 4%;\n    width: 36vw;\n    max-width: 520px;\n    height: auto;\n    opacity: 0.50;\n    pointer-events: none;\n    z-index: 1;\n    color: var(--accent-1);\n  }\n  .constellation-group {\n    animation: slowRotate 120s linear infinite;\n    transform-origin: 250px 200px;\n  }\n  @keyframes slowRotate {\n    to { transform: rotate(360deg); }\n  }\n  .hero-rail {\n    position: absolute;\n    right: 0;\n    top: 0;\n    bottom: 0;\n    width: 28px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 3;\n    pointer-events: none;\n  }\n  .hero-rail span {\n    display: block;\n    font-family: 'Space Mono', monospace;\n    font-size: 9px;\n    letter-spacing: 0.24em;\n    text-transform: uppercase;\n    color: var(--text-muted);\n    opacity: 0.60;\n    white-space: nowrap;\n    transform: rotate(90deg);\n  }\n  .hero-content {\n    position: relative;\n    z-index: 2;\n    text-align: right;\n    padding: 0 7vw 0 0;\n    max-width: 54%;\n  }\n  .hero-eyebrow {\n    display: flex;\n    align-items: center;\n    justify-content: flex-end;\n    gap: 10px;\n    font-family: 'Space Mono', monospace;\n    font-size: 10px;\n    letter-spacing: 0.20em;\n    text-transform: uppercase;\n    color: var(--accent-1);\n    margin-bottom: 28px;\n  }\n  .hero-eyebrow::before {\n    content: '✦';\n    font-size: 8px;\n  }\n  .hero-headline {\n    font-family: 'Italiana', serif;\n    font-weight: 400;\n    font-size: clamp(28px, 3.6vw, 50px);\n    line-height: 1.02;\n    letter-spacing: 0.04em;\n    color: var(--text-primary);\n    margin-bottom: 28px;\n    position: relative;\n    overflow: hidden;\n  }\n  .hero-headline::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: var(--bg-primary);\n    transform: scaleX(1);\n    transform-origin: right;\n    transition: transform 900ms var(--ease-expo);\n  }\n  .hero-headline.is-in::after {\n    transform: scaleX(0);\n  }\n  .hero-headline .glow {\n    color: var(--accent-1);\n    text-shadow: 0 0 40px rgba(217, 140, 64, 0.45), 0 0 80px rgba(217, 140, 64, 0.2);\n  }\n  .hero-rule {\n    width: 60px;\n    height: 1px;\n    background: var(--accent-1);\n    margin: 0 0 28px auto;\n  }\n  .hero-sub {\n    font-size: 16px;\n    opacity: 0.70;\n    margin-bottom: 36px;\n    max-width: 380px;\n    margin-left: auto;\n  }\n  .hero-cta {\n    display: inline-block;\n    background: var(--accent-1);\n    color: var(--bg-primary);\n    font-family: 'Space Mono', monospace;\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    padding: 14px 28px;\n    text-decoration: none;\n    transition: background 200ms, transform 200ms;\n  }\n  .hero-cta:hover {\n    background: #e6a05d;\n    transform: translateY(-1px);\n  }\n  .scroll-indicator {\n    position: absolute;\n    bottom: 36px;\n    left: 50%;\n    transform: translateX(-50%);\n    z-index: 2;\n    opacity: 0.50;\n    animation: scrollBounce 2.2s ease-in-out infinite;\n  }\n  @keyframes scrollBounce {\n    0%, 100% { transform: translateX(-50%) translateY(0); }\n    50% { transform: translateX(-50%) translateY(7px); }\n  }\n\n  /* ─── SECTION 1 — ROUTES (Spotlight) ────────────────────── */\n\n  .routes {\n    position: relative;\n    background: var(--bg-secondary);\n    overflow: hidden;\n  }\n  .routes-bg-base {\n    position: absolute;\n    inset: 0;\n    background: var(--bg-secondary);\n  }\n  .routes-bg-base img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    opacity: 0.2;\n    filter: grayscale(80%) sepia(20%);\n    display: block;\n  }\n  .routes-bg-reveal {\n    position: absolute;\n    inset: 0;\n    background: var(--bg-secondary);\n    -webkit-mask-image: radial-gradient(circle at 50% 50%, black 180px, transparent 280px);\n    mask-image: radial-gradient(circle at 50% 50%, black 180px, transparent 280px);\n    transition: opacity 300ms ease;\n    opacity: 0;\n  }\n  .routes:hover .routes-bg-reveal { opacity: 1; }\n  .routes-bg-reveal img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    opacity: 0.85;\n    display: block;\n  }\n  .routes-content {\n    position: relative;\n    z-index: 5;\n    padding: 120px 8vw;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 80px;\n    max-width: 1440px;\n    margin: 0 auto;\n    align-items: center;\n  }\n  .section-eyebrow {\n    font-family: 'Space Mono', monospace;\n    font-size: 10px;\n    letter-spacing: 0.20em;\n    text-transform: uppercase;\n    color: var(--accent-1);\n    margin-bottom: 24px;\n  }\n  .routes-headline {\n    font-family: 'Fraunces', serif;\n    font-weight: 900;\n    font-style: italic;\n    font-variation-settings: 'SOFT' 100, 'opsz' 144;\n    font-size: clamp(40px, 5vw, 68px);\n    line-height: 1.04;\n    color: var(--text-primary);\n    margin-bottom: 24px;\n    opacity: 0;\n    transform: translateY(30px) skewY(5deg);\n    transition: opacity 800ms var(--ease-expo), transform 800ms var(--ease-expo);\n  }\n  .routes-headline.is-in {\n    opacity: 1;\n    transform: translateY(0) skewY(0deg);\n  }\n  .routes-body {\n    font-size: 15px;\n    color: var(--text-muted);\n    margin-bottom: 40px;\n    max-width: 380px;\n  }\n  .route-cards {\n    display: flex;\n    flex-direction: column;\n    margin-bottom: 32px;\n  }\n  .route-card {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 24px 20px;\n    border-top: 1px solid rgba(168, 146, 133, 0.15);\n    border-left: 3px solid var(--accent-1);\n    cursor: pointer;\n    opacity: 0;\n    transform: translateX(24px);\n    transition: opacity 700ms var(--ease-expo), transform 700ms var(--ease-expo), background 200ms ease;\n  }\n  .route-card:last-child {\n    border-bottom: 1px solid rgba(168, 146, 133, 0.15);\n  }\n  .route-card:hover { background: rgba(217, 140, 64, 0.08); }\n  .route-card.is-in {\n    opacity: 1;\n    transform: translateX(0);\n  }\n  .route-name {\n    font-family: 'Fraunces', serif;\n    font-weight: 700;\n    font-style: italic;\n    font-size: 20px;\n    color: var(--text-primary);\n    margin-bottom: 4px;\n  }\n  .route-region {\n    font-family: 'Space Mono', monospace;\n    font-size: 9px;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: var(--text-muted);\n  }\n  .route-right {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n  }\n  .route-duration {\n    font-size: 12px;\n    color: var(--text-muted);\n  }\n  .route-arrow {\n    font-size: 18px;\n    color: var(--accent-1);\n  }\n\n  /* ─── SECTION 2 — VOICES (Word Mask) ───────────────────── */\n\n  .voices {\n    background: var(--surface-mid);\n    padding: 140px 8vw;\n    overflow: hidden;\n  }\n  .voices-inner {\n    max-width: 1100px;\n    margin: 0 auto;\n  }\n  .word-mask-headline {\n    font-family: 'Fraunces', serif;\n    font-weight: 900;\n    font-style: italic;\n    font-variation-settings: 'SOFT' 100, 'opsz' 144;\n    font-size: clamp(44px, 6vw, 80px);\n    line-height: 1.08;\n    margin-bottom: 80px;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.2em;\n  }\n  .wmw {\n    display: inline-block;\n    color: var(--text-muted);\n    transition: color 600ms var(--ease-expo), -webkit-text-fill-color 600ms var(--ease-expo);\n  }\n  .wmw.filled {\n    color: var(--accent-1);\n    background: linear-gradient(135deg, var(--accent-1) 30%, var(--text-primary) 80%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n  .voice-block {\n    margin-bottom: 64px;\n    opacity: 0;\n    transform: translateY(20px);\n    transition: opacity 800ms var(--ease-expo), transform 800ms var(--ease-expo);\n  }\n  .voice-block.is-in { opacity: 1; transform: translateY(0); }\n  .voice-primary-block { max-width: 820px; }\n  .voice-secondary-block { max-width: 600px; margin-left: auto; text-align: right; }\n  .voice-tertiary-block { max-width: 460px; margin: 0 auto; text-align: center; }\n  \n  .voice-quote-primary {\n    font-family: 'Fraunces', serif;\n    font-weight: 700;\n    font-style: italic;\n    font-size: clamp(26px, 3vw, 40px);\n    line-height: 1.2;\n    color: var(--accent-1);\n    margin-bottom: 16px;\n  }\n  .voice-quote-secondary {\n    font-family: 'Fraunces', serif;\n    font-weight: 700;\n    font-style: italic;\n    font-size: clamp(20px, 2.2vw, 28px);\n    line-height: 1.28;\n    color: var(--text-primary);\n    margin-bottom: 12px;\n  }\n  .voice-cite {\n    font-family: 'Space Mono', monospace;\n    font-size: 10px;\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    color: var(--text-muted);\n    opacity: 0.7;\n  }\n\n  /* ─── SECTION 3 — CROSSINGS (3D Tilt) ──────────────────── */\n\n  .crossings {\n    background: var(--bg-primary);\n    padding: 140px 6vw;\n  }\n  .crossings-header {\n    max-width: 1440px;\n    margin: 0 auto 100px auto;\n  }\n  .crossings-headline {\n    font-family: 'Fraunces', serif;\n    font-weight: 900;\n    font-style: italic;\n    font-variation-settings: 'SOFT' 100, 'opsz' 144;\n    font-size: clamp(38px, 5vw, 64px);\n    line-height: 1.06;\n    color: var(--text-primary);\n    opacity: 0;\n    letter-spacing: 0.3em;\n    transition: letter-spacing 1.2s var(--ease-expo), opacity 1s var(--ease-expo);\n  }\n  .crossings-headline.is-in {\n    opacity: 1;\n    letter-spacing: 0.01em;\n  }\n  .crossing-grid {\n    max-width: 1440px;\n    margin: 0 auto;\n    perspective: 2000px;\n  }\n  .crossing-cards-inner {\n    display: grid;\n    grid-template-columns: 44fr 32fr 24fr;\n    gap: 32px;\n    align-items: start;\n  }\n  .crossing-card {\n    opacity: 0;\n    transform: translateY(40px);\n    transition: opacity 800ms var(--ease-expo), transform 800ms var(--ease-expo);\n    transform-style: preserve-3d;\n    will-change: transform;\n  }\n  .crossing-card.is-in { opacity: 1; transform: translateY(0); }\n  .card-2 {\n    margin-top: 100px;\n    border: 1px solid var(--accent-2);\n    padding: 48px 36px;\n    background: var(--bg-secondary);\n  }\n  .card-3 { margin-top: 200px; }\n  .crossing-card-image-wrap {\n    background: var(--surface-mid);\n    overflow: hidden;\n    margin-bottom: 24px;\n  }\n  .crossing-card-image {\n    width: 100%;\n    display: block;\n    object-fit: cover;\n    transition: transform 600ms var(--ease-expo);\n  }\n  .crossing-card:hover .crossing-card-image { transform: scale(1.05); }\n  .card-1 .crossing-card-image { aspect-ratio: 2/3; }\n  .card-3 .crossing-card-image { aspect-ratio: 3/4; }\n  \n  .crossing-coords {\n    font-family: 'Space Mono', monospace;\n    font-size: 9px;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: var(--accent-1);\n    margin-bottom: 12px;\n  }\n  .crossing-title {\n    font-family: 'Fraunces', serif;\n    font-weight: 700;\n    font-style: italic;\n    font-size: 26px;\n    line-height: 1.18;\n    color: var(--text-primary);\n    margin-bottom: 16px;\n  }\n  .crossing-body {\n    font-size: 14px;\n    color: var(--text-muted);\n    margin-bottom: 16px;\n  }\n\n  /* ─── FOOTER ──────────────────────────────────────────── */\n\n  footer {\n    background: var(--bg-primary);\n    padding: 0 6vw 80px 6vw;\n  }\n  .footer-top-rule {\n    height: 1px;\n    background: linear-gradient(90deg, transparent 0%, var(--accent-1) 30%, var(--accent-1) 70%, transparent 100%);\n    margin-bottom: 100px;\n  }\n  .footer-inner {\n    max-width: 1440px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: 1.8fr 1.6fr 1.3fr;\n    gap: 80px;\n    align-items: start;\n  }\n  .footer-logo {\n    display: block;\n    font-family: 'Italiana', serif;\n    font-weight: 400;\n    font-size: clamp(52px, 7vw, 100px);\n    line-height: 0.95;\n    letter-spacing: 0.03em;\n    color: var(--text-primary);\n    text-decoration: none;\n    margin-bottom: 20px;\n  }\n  .footer-tagline {\n    font-style: italic;\n    font-size: 17px;\n    color: var(--text-muted);\n  }\n  .footer-nav {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 40px;\n  }\n  .footer-col-label {\n    font-family: 'Space Mono', monospace;\n    font-size: 9px;\n    letter-spacing: 0.20em;\n    text-transform: uppercase;\n    color: var(--accent-1);\n    margin-bottom: 24px;\n  }\n  .footer-links-list {\n    list-style: none;\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n  }\n  .footer-links-list a {\n    font-size: 14px;\n    color: var(--text-primary);\n    text-decoration: none;\n    opacity: 0.75;\n    transition: opacity 200ms;\n  }\n  .footer-links-list a:hover { opacity: 1; }\n  .footer-links-list .star-bullet::before {\n    content: '✦ ';\n    color: var(--accent-1);\n    font-size: 7px;\n    vertical-align: middle;\n  }\n  .footer-cta-box {\n    border: 1px solid var(--accent-1);\n    padding: 40px 32px;\n    opacity: 0;\n    transform: translateX(30px);\n    transition: opacity 800ms var(--ease-expo), transform 800ms var(--ease-expo);\n  }\n  .footer-cta-box.is-in { opacity: 1; transform: translateX(0); }\n  .footer-cta-copy {\n    font-family: 'Fraunces', serif;\n    font-weight: 700;\n    font-style: italic;\n    font-size: 20px;\n    line-height: 1.48;\n    color: var(--text-primary);\n    margin-bottom: 28px;\n  }\n\n  /* Utilities */\n  .u-reveal { transition-delay: calc(var(--d, 0) * 100ms); }\n\n  @media (max-width: 900px) {\n    .nav-links { display: none; }\n    .hero-content { max-width: 85%; padding-right: 5vw; }\n    .routes-content { grid-template-columns: 1fr; gap: 60px; }\n    .crossing-cards-inner { grid-template-columns: 1fr; }\n    .card-2, .card-3 { margin-top: 40px; }\n    .footer-inner { grid-template-columns: 1fr; gap: 60px; }\n  }\n</style>\n<nav data-kid=\"1\" data-name=\"main navigation bar\" id=\"main-nav\">\n    <div class=\"nav-inner\" data-kid=\"1-1\" data-name=\"navigation inner container\">\n        <a class=\"nav-logo\" data-kid=\"1-1-1\" data-name=\"navigation brand logo\" href=\"#\">\n            Horizon\n        </a>\n        <div class=\"nav-links\" data-kid=\"1-1-2\" data-name=\"navigation links group\">\n            <a data-kid=\"1-1-2-1\" data-name=\"expeditions navigation link\" href=\"#routes\">\n                Expeditions\n            </a>\n            <a data-kid=\"1-1-2-2\" data-name=\"dispatches navigation link\" href=\"#voices\">\n                Dispatches\n            </a>\n            <a data-kid=\"1-1-2-3\" data-name=\"about navigation link\" href=\"#\">\n                About\n            </a>\n            <a class=\"nav-cta\" data-kid=\"1-1-2-4\" data-name=\"call-to-action navigation button\" href=\"#\">\n                Begin →\n            </a>\n        </div>\n    </div>\n</nav>\n<section class=\"hero\" data-kid=\"2\" data-name=\"hero section\">\n    <video autoplay=\"\" data-kid=\"2-1\" data-name=\"hero background video\" id=\"hero-video\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/5728372/pexels-photo-5728372.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\">\n        <source data-kid=\"2-1-1\" src=\"https://videos.pexels.com/video-files/5728372/5728372-uhd_3840_2160_30fps.mp4\" type=\"video/mp4\"/>\n    </video>\n    <div class=\"hero-overlay\" data-kid=\"2-2\" data-name=\"hero overlay gradient layer\">\n    </div>\n    <svg class=\"constellation\" data-kid=\"2-3\" data-name=\"animated constellation graphic\" viewbox=\"0 0 500 400\">\n        <g class=\"constellation-group\">\n            <circle cx=\"100\" cy=\"100\" fill=\"currentColor\" r=\"1.5\">\n            </circle>\n            <circle cx=\"180\" cy=\"120\" fill=\"currentColor\" r=\"2\">\n            </circle>\n            <circle cx=\"220\" cy=\"80\" fill=\"currentColor\" r=\"1.5\">\n            </circle>\n            <circle cx=\"280\" cy=\"150\" fill=\"currentColor\" r=\"2.5\">\n            </circle>\n            <circle cx=\"140\" cy=\"220\" fill=\"currentColor\" r=\"1.5\">\n            </circle>\n            <circle cx=\"200\" cy=\"280\" fill=\"currentColor\" r=\"2\">\n            </circle>\n            <line opacity=\"0.3\" stroke=\"currentColor\" stroke-width=\"0.5\" x1=\"100\" x2=\"180\" y1=\"100\" y2=\"120\">\n            </line>\n            <line opacity=\"0.3\" stroke=\"currentColor\" stroke-width=\"0.5\" x1=\"180\" x2=\"220\" y1=\"120\" y2=\"80\">\n            </line>\n            <line opacity=\"0.3\" stroke=\"currentColor\" stroke-width=\"0.5\" x1=\"180\" x2=\"280\" y1=\"120\" y2=\"150\">\n            </line>\n            <line opacity=\"0.3\" stroke=\"currentColor\" stroke-width=\"0.5\" x1=\"100\" x2=\"140\" y1=\"100\" y2=\"220\">\n            </line>\n            <line opacity=\"0.3\" stroke=\"currentColor\" stroke-width=\"0.5\" x1=\"140\" x2=\"200\" y1=\"220\" y2=\"280\">\n            </line>\n        </g>\n    </svg>\n    <div class=\"hero-rail\" data-kid=\"2-4\" data-name=\"side rail container\">\n        <span data-kid=\"2-4-1\" data-name=\"side rail location text\">\n            DARK SKY EXPEDITIONS · 64°N · 140°E\n        </span>\n    </div>\n    <div class=\"hero-content\" data-kid=\"2-5\" data-name=\"hero content block\">\n        <div class=\"hero-eyebrow\" data-kid=\"2-5-1\" data-name=\"hero eyebrow label\">\n            Expeditions at the edge of the charted world\n        </div>\n        <h1 class=\"hero-headline\" data-kid=\"2-5-2\" data-name=\"hero main headline\">\n            Where the\n            <span class=\"glow\" data-kid=\"2-5-2-1\" data-name=\"glowing headline emphasis word\">\n                night\n            </span>\n            <br data-kid=\"2-5-2-2\"/>\n            goes to work.\n        </h1>\n        <div class=\"hero-rule\" data-kid=\"2-5-3\" data-name=\"hero decorative horizontal rule\">\n        </div>\n        <p class=\"hero-sub\" data-kid=\"2-5-4\" data-name=\"hero subheadline text\">\n            Elite wilderness expeditions shaped by darkness, silence, and the spaces between stars.\n        </p>\n        <a class=\"hero-cta\" data-kid=\"2-5-5\" data-name=\"hero primary call-to-action button\" href=\"#routes\">\n            Begin Your Expedition →\n        </a>\n    </div>\n    <div class=\"scroll-indicator\" data-kid=\"2-6\" data-name=\"scroll indicator container\">\n        <svg data-kid=\"2-6-1\" data-name=\"down arrow icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"24\">\n            <path d=\"M12 5v14M19 12l-7 7-7-7\">\n            </path>\n        </svg>\n    </div>\n</section>\n<section class=\"routes\" data-kid=\"3\" data-name=\"routes section\" id=\"routes\">\n    <div class=\"routes-bg-base\" data-kid=\"3-1\" data-name=\"base route section background image container\">\n        <img alt=\"Desert canyon at twilight\" data-kid=\"3-1-1\" data-name=\"base route section image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1516325759459-7251ff998ab8?auto=format&w=1440&q=80\"/>\n    </div>\n    <div class=\"routes-bg-reveal\" data-dynamic=\"true\" data-kid=\"3-2\" data-name=\"reveal route section background image container\" data-reason=\"background image reveal circle position updated on mouse move\">\n        <img alt=\"Desert canyon vivid\" data-kid=\"3-2-1\" data-name=\"reveal route section image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1516325759459-7251ff998ab8?auto=format&w=1440&q=80\"/>\n    </div>\n    <div class=\"routes-content\" data-kid=\"3-3\" data-name=\"routes content layout grid\">\n        <div class=\"routes-text\" data-kid=\"3-3-1\" data-name=\"routes text content block\">\n            <div class=\"section-eyebrow\" data-kid=\"3-3-1-1\" data-name=\"routes section eyebrow label\">\n                The Expeditions\n            </div>\n            <h2 class=\"routes-headline\" data-kid=\"3-3-1-2\" data-name=\"routes section headline\">\n                Not a tour.\n                <br data-kid=\"3-3-1-2-1\"/>\n                Not a package.\n            </h2>\n            <p class=\"routes-body\" data-kid=\"3-3-1-3\" data-name=\"routes section description body\">\n                An expedition shaped around your capacity for wonder. Three continents, one standard: the dark frontier.\n            </p>\n            <a class=\"section-link\" data-kid=\"3-3-1-4\" data-name=\"view all expeditions link\" href=\"#\">\n                View all expeditions →\n            </a>\n        </div>\n        <div class=\"route-cards\" data-kid=\"3-3-2\" data-name=\"route cards container\">\n            <div class=\"route-card\" data-kid=\"3-3-2-1\" data-name=\"first route card\" style=\"--d: 1\">\n                <div class=\"route-meta\" data-kid=\"3-3-2-1-1\" data-name=\"first route card details wrapper\">\n                    <div class=\"route-name\" data-kid=\"3-3-2-1-1-1\" data-name=\"first route card title\">\n                        Northern Lights Passage\n                    </div>\n                    <div class=\"route-region\" data-kid=\"3-3-2-1-1-2\" data-name=\"first route card region\">\n                        Iceland\n                    </div>\n                </div>\n                <div class=\"route-right\" data-kid=\"3-3-2-1-2\" data-name=\"first route card auxiliary info wrapper\">\n                    <span class=\"route-duration\" data-kid=\"3-3-2-1-2-1\" data-name=\"first route card duration\">\n                        14 nights\n                    </span>\n                    <span class=\"route-arrow\" data-kid=\"3-3-2-1-2-2\" data-name=\"first route card arrow icon\">\n                        →\n                    </span>\n                </div>\n            </div>\n            <div class=\"route-card\" data-kid=\"3-3-2-2\" data-name=\"second route card\" style=\"--d: 2\">\n                <div class=\"route-meta\" data-kid=\"3-3-2-2-1\" data-name=\"second route card details wrapper\">\n                    <div class=\"route-name\" data-kid=\"3-3-2-2-1-1\" data-name=\"second route card title\">\n                        Atacama Night Trek\n                    </div>\n                    <div class=\"route-region\" data-kid=\"3-3-2-2-1-2\" data-name=\"second route card region\">\n                        Chile\n                    </div>\n                </div>\n                <div class=\"route-right\" data-kid=\"3-3-2-2-2\" data-name=\"second route card auxiliary info wrapper\">\n                    <span class=\"route-duration\" data-kid=\"3-3-2-2-2-1\" data-name=\"second route card duration\">\n                        9 nights\n                    </span>\n                    <span class=\"route-arrow\" data-kid=\"3-3-2-2-2-2\" data-name=\"second route card arrow icon\">\n                        →\n                    </span>\n                </div>\n            </div>\n            <div class=\"route-card\" data-kid=\"3-3-2-3\" data-name=\"third route card\" style=\"--d: 3\">\n                <div class=\"route-meta\" data-kid=\"3-3-2-3-1\" data-name=\"third route card details wrapper\">\n                    <div class=\"route-name\" data-kid=\"3-3-2-3-1-1\" data-name=\"third route card title\">\n                        Namibian Dark Sky Reserve\n                    </div>\n                    <div class=\"route-region\" data-kid=\"3-3-2-3-1-2\" data-name=\"third route card region\">\n                        Namibia\n                    </div>\n                </div>\n                <div class=\"route-right\" data-kid=\"3-3-2-3-2\" data-name=\"third route card auxiliary info wrapper\">\n                    <span class=\"route-duration\" data-kid=\"3-3-2-3-2-1\" data-name=\"third route card duration\">\n                        11 nights\n                    </span>\n                    <span class=\"route-arrow\" data-kid=\"3-3-2-3-2-2\" data-name=\"third route card arrow icon\">\n                        →\n                    </span>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n<section class=\"voices\" data-kid=\"4\" data-name=\"voices section\" id=\"voices\">\n    <div class=\"voices-inner\" data-kid=\"4-1\" data-name=\"voices inner content container\">\n        <h2 class=\"word-mask-headline\" data-kid=\"4-1-1\" data-name=\"word mask headline\">\n            <span class=\"wmw\" data-dynamic=\"true\" data-kid=\"4-1-1-1\" data-name=\"word mask segment 1\" data-reason=\"text color filled based on scroll position\">\n                They\n            </span>\n            <span class=\"wmw\" data-dynamic=\"true\" data-kid=\"4-1-1-2\" data-name=\"word mask segment 2\" data-reason=\"text color filled based on scroll position\">\n                chose\n            </span>\n            <span class=\"wmw\" data-dynamic=\"true\" data-kid=\"4-1-1-3\" data-name=\"word mask segment 3\" data-reason=\"text color filled based on scroll position\">\n                the\n            </span>\n            <span class=\"wmw\" data-dynamic=\"true\" data-kid=\"4-1-1-4\" data-name=\"word mask segment 4\" data-reason=\"text color filled based on scroll position\">\n                dark.\n            </span>\n        </h2>\n        <div class=\"voice-block voice-primary-block\" data-kid=\"4-1-2\" data-name=\"primary voice testimonial block\">\n            <p class=\"voice-quote-primary\" data-kid=\"4-1-2-1\" data-name=\"primary voice quote\">\n                \"The sky reminded me I was nowhere near home.\"\n            </p>\n            <div class=\"voice-cite\" data-kid=\"4-1-2-2\" data-name=\"primary voice citation\">\n                — Mara K., Iceland Expedition 2024\n            </div>\n        </div>\n        <div class=\"voice-block voice-secondary-block\" data-kid=\"4-1-3\" data-name=\"secondary voice testimonial block\">\n            <p class=\"voice-quote-secondary\" data-kid=\"4-1-3-1\" data-name=\"secondary voice quote\">\n                \"Fourteen nights. Zero regrets.\"\n            </p>\n            <div class=\"voice-cite\" data-kid=\"4-1-3-2\" data-name=\"secondary voice citation\">\n                — James O., Atacama Night Trek 2023\n            </div>\n        </div>\n        <div class=\"voice-block voice-tertiary-block\" data-kid=\"4-1-4\" data-name=\"tertiary voice testimonial block\">\n            <p class=\"voice-quote-secondary\" data-kid=\"4-1-4-1\" data-name=\"tertiary voice quote\">\n                \"Every horizon crossed left us more certain of the next.\"\n            </p>\n            <div class=\"voice-cite\" data-kid=\"4-1-4-2\" data-name=\"tertiary voice citation\">\n                — The Rivas family, Namibia 2024\n            </div>\n        </div>\n    </div>\n</section>\n<section class=\"crossings\" data-kid=\"5\" data-name=\"crossings section\">\n    <div class=\"crossings-header\" data-kid=\"5-1\" data-name=\"crossings header block\">\n        <div class=\"section-eyebrow\" data-kid=\"5-1-1\" data-name=\"crossings section eyebrow label\">\n            Field Dispatches\n        </div>\n        <h2 class=\"crossings-headline\" data-kid=\"5-1-2\" data-name=\"crossings main headline\">\n            Three crossings.\n            <br data-kid=\"5-1-2-1\"/>\n            One standard.\n        </h2>\n    </div>\n    <div class=\"crossing-grid\" data-kid=\"5-2\" data-name=\"crossings grid container\">\n        <div class=\"crossing-cards-inner\" data-kid=\"5-2-1\" data-name=\"crossing cards inner grid\">\n            <article class=\"crossing-card card-1\" data-dynamic=\"true\" data-kid=\"5-2-1-1\" data-name=\"first crossing card\" data-reason=\"3D transform state updated on mouse move\">\n                <div class=\"crossing-card-image-wrap\" data-kid=\"5-2-1-1-1\" data-name=\"first crossing card image wrapper\">\n                    <img alt=\"Nomad in desert\" class=\"crossing-card-image\" data-kid=\"5-2-1-1-1-1\" data-name=\"first crossing card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1578010505119-50ce76b771a0?auto=format&w=800&q=80\"/>\n                </div>\n                <div class=\"crossing-coords\" data-kid=\"5-2-1-1-2\" data-name=\"first crossing card coordinates text\">\n                    23°52′S · 69°01′W\n                </div>\n                <h3 class=\"crossing-title\" data-kid=\"5-2-1-1-3\" data-name=\"first crossing card title\">\n                    Atacama: Where the Sky Begins\n                </h3>\n                <p class=\"crossing-body\" data-kid=\"5-2-1-1-4\" data-name=\"first crossing card description body\">\n                    At 5,000 metres, you stop trying to name what you see and start listening to what the silence is saying.\n                </p>\n            </article>\n            <article class=\"crossing-card card-2\" data-dynamic=\"true\" data-kid=\"5-2-1-2\" data-name=\"second crossing card\" data-reason=\"3D transform state updated on mouse move\">\n                <div class=\"crossing-coords\" data-kid=\"5-2-1-2-1\" data-name=\"second crossing card coordinates text\">\n                    64°21′S · 30°14′W\n                </div>\n                <h3 class=\"crossing-title\" data-kid=\"5-2-1-2-2\" data-name=\"second crossing card title\">\n                    The Bolivian Meridian\n                </h3>\n                <p class=\"crossing-body\" data-kid=\"5-2-1-2-3\" data-name=\"second crossing card description body 1\">\n                    Twelve days on the world's largest mirror. The salt reflects every star above — you walk through the sky.\n                </p>\n                <p class=\"crossing-body\" data-kid=\"5-2-1-2-4\" data-name=\"second crossing card description body 2\">\n                    Nine nights. No phones after sunset. Every expedition is designed to exceed the extraordinary imagination.\n                </p>\n            </article>\n            <article class=\"crossing-card card-3\" data-dynamic=\"true\" data-kid=\"5-2-1-3\" data-name=\"third crossing card\" data-reason=\"3D transform state updated on mouse move\">\n                <div class=\"crossing-card-image-wrap\" data-kid=\"5-2-1-3-1\" data-name=\"third crossing card image wrapper\">\n                    <img alt=\"Safari tents lit up\" class=\"crossing-card-image\" data-kid=\"5-2-1-3-1-1\" data-name=\"third crossing card image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1688988816492-f71727a11149?auto=format&w=800&q=80\"/>\n                </div>\n                <div class=\"crossing-coords\" data-kid=\"5-2-1-3-2\" data-name=\"third crossing card coordinates text\">\n                    41°50′N · 79°11′E\n                </div>\n                <h3 class=\"crossing-title\" data-kid=\"5-2-1-3-3\" data-name=\"third crossing card title\">\n                    Tian Shan Night Watch\n                </h3>\n                <p class=\"crossing-body\" data-kid=\"5-2-1-3-4\" data-name=\"third crossing card description body\">\n                    Eleven nights at high altitude. Unfiltered sky above, silence below.\n                </p>\n            </article>\n        </div>\n    </div>\n</section>\n<footer data-kid=\"6\" data-name=\"site footer\">\n    <div class=\"footer-top-rule\" data-kid=\"6-1\" data-name=\"footer top decorative rule\">\n    </div>\n    <div class=\"footer-inner\" data-kid=\"6-2\" data-name=\"footer inner container\">\n        <div class=\"footer-brand\" data-kid=\"6-2-1\" data-name=\"footer brand section\">\n            <a class=\"footer-logo\" data-kid=\"6-2-1-1\" data-name=\"footer logo link\" href=\"#\">\n                Horizon\n            </a>\n            <p class=\"footer-tagline\" data-kid=\"6-2-1-2\" data-name=\"footer tagline\">\n                Where the night goes to work.\n            </p>\n        </div>\n        <nav class=\"footer-nav\" data-kid=\"6-2-2\" data-name=\"footer navigation links section\">\n            <div class=\"footer-col\" data-kid=\"6-2-2-1\" data-name=\"footer expeditions links column\">\n                <div class=\"footer-col-label\" data-kid=\"6-2-2-1-1\" data-name=\"footer expeditions column label\">\n                    Expeditions\n                </div>\n                <ul class=\"footer-links-list\" data-kid=\"6-2-2-1-2\" data-name=\"footer expeditions links list\">\n                    <li data-kid=\"6-2-2-1-2-1\">\n                        <a data-kid=\"6-2-2-1-2-1-1\" href=\"#\">\n                            Northern Lights Passage\n                        </a>\n                    </li>\n                    <li data-kid=\"6-2-2-1-2-2\">\n                        <a data-kid=\"6-2-2-1-2-2-1\" href=\"#\">\n                            Atacama Night Trek\n                        </a>\n                    </li>\n                    <li data-kid=\"6-2-2-1-2-3\">\n                        <a data-kid=\"6-2-2-1-2-3-1\" href=\"#\">\n                            Namibian Dark Sky Reserve\n                        </a>\n                    </li>\n                    <li data-kid=\"6-2-2-1-2-4\">\n                        <a data-kid=\"6-2-2-1-2-4-1\" href=\"#\">\n                            Tian Shan Night Watch\n                        </a>\n                    </li>\n                    <li data-kid=\"6-2-2-1-2-5\">\n                        <a class=\"star-bullet\" data-kid=\"6-2-2-1-2-5-1\" href=\"#\">\n                            View All\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div class=\"footer-col\" data-kid=\"6-2-2-2\" data-name=\"footer company links column\">\n                <div class=\"footer-col-label\" data-kid=\"6-2-2-2-1\" data-name=\"footer company column label\">\n                    Company\n                </div>\n                <ul class=\"footer-links-list\" data-kid=\"6-2-2-2-2\" data-name=\"footer company links list\">\n                    <li data-kid=\"6-2-2-2-2-1\">\n                        <a data-kid=\"6-2-2-2-2-1-1\" href=\"#\">\n                            About Horizon\n                        </a>\n                    </li>\n                    <li data-kid=\"6-2-2-2-2-2\">\n                        <a data-kid=\"6-2-2-2-2-2-1\" href=\"#\">\n                            Dispatches\n                        </a>\n                    </li>\n                    <li data-kid=\"6-2-2-2-2-3\">\n                        <a data-kid=\"6-2-2-2-2-3-1\" href=\"#\">\n                            Field Notes\n                        </a>\n                    </li>\n                    <li data-kid=\"6-2-2-2-2-4\">\n                        <a data-kid=\"6-2-2-2-2-4-1\" href=\"#\">\n                            Contact\n                        </a>\n                    </li>\n                </ul>\n            </div>\n        </nav>\n        <div class=\"footer-cta-box\" data-kid=\"6-2-3\" data-name=\"footer call-to-action box\">\n            <p class=\"footer-cta-copy\" data-kid=\"6-2-3-1\" data-name=\"footer call-to-action copy\">\n                Ready to go somewhere maps don't show?\n            </p>\n            <a class=\"hero-cta\" data-kid=\"6-2-3-2\" data-name=\"footer primary call-to-action button\" href=\"#\">\n                Begin an Expedition →\n            </a>\n            <div data-kid=\"6-2-3-3\" data-name=\"footer copyright and stats text\" style=\"margin-top: 24px; font-size: 10px; color: var(--text-muted); font-family: 'Space Mono', monospace;\">\n                © 2025 Horizon Expeditions\n                <br data-kid=\"6-2-3-3-1\"/>\n                Est. 2012 · 2,300+ Crossings Guided\n            </div>\n        </div>\n    </div>\n</footer>\n<script>\n    // 1. Nav Scroll\n  const nav = document.getElementById('main-nav');\n  window.addEventListener('scroll', () => {\n    nav.classList.toggle('scrolled', window.scrollY > 50);\n  });\n\n  // 2. Intersection Observer for Reveals\n  const observer = new IntersectionObserver((entries) => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        entry.target.classList.add('is-in');\n      }\n    });\n  }, { threshold: 0.15 });\n\n  document.querySelectorAll('.hero-headline, .routes-headline, .route-card, .voice-block, .crossings-headline, .crossing-card, .footer-cta-box').forEach(el => observer.observe(entry.target || el));\n\n  // 3. Routes Spotlight\n  const routesSection = document.querySelector('.routes');\n  const routesReveal = document.querySelector('.routes-bg-reveal');\n  routesSection.addEventListener('pointermove', e => {\n    const rect = routesSection.getBoundingClientRect();\n    const x = e.clientX - rect.left;\n    const y = e.clientY - rect.top;\n    routesReveal.style.webkitMaskImage = `radial-gradient(circle at ${x}px ${y}px, black 180px, transparent 280px)`;\n    routesReveal.style.maskImage = `radial-gradient(circle at ${x}px ${y}px, black 180px, transparent 280px)`;\n  });\n\n  // 4. Word Mask Scroll Fill\n  const words = document.querySelectorAll('.wmw');\n  window.addEventListener('scroll', () => {\n    const section = document.querySelector('.voices');\n    const rect = section.getBoundingClientRect();\n    const progress = Math.min(Math.max((window.innerHeight - rect.top) / (window.innerHeight + rect.height), 0), 1);\n    \n    words.forEach((word, idx) => {\n      const threshold = idx / words.length;\n      if (progress > threshold) {\n        word.classList.add('filled');\n      } else {\n        word.classList.remove('filled');\n      }\n    });\n  });\n\n  // 5. 3D Tilt Cards\n  document.querySelectorAll('.crossing-card').forEach(card => {\n    card.addEventListener('pointermove', e => {\n      const rect = card.getBoundingClientRect();\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n      const xc = rect.width / 2;\n      const yc = rect.height / 2;\n      const dx = x - xc;\n      const dy = y - yc;\n      card.style.transform = `perspective(1000px) rotateX(${-dy / 20}deg) rotateY(${dx / 20}deg) translateZ(20px)`;\n    });\n    card.addEventListener('pointerleave', () => {\n      card.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateZ(0)';\n    });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-07-23T05:38:06.010543+00:00",
      "modified": "2026-07-23T05:38:56.979249+00:00",
      "id": "var_e0675ffc4101"
    },
    "var_0e8b59007d34": {
      "type": "variant",
      "label": "Modern Bold",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Italiana&family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Manrope:wght@300;400;500&family=Space+Mono:wght@400&display=swap');\n\n  :root {\n    --bg-primary: #001233;\n    --bg-secondary: #001B4D;\n    --text-primary: #FFFFFF;\n    --text-muted: #A0B0D0;\n    --accent-1: #F4C430;\n    --accent-2: #FF9933;\n    --surface-mid: #002466;\n    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);\n  }\n\n  body {\n    background-color: var(--bg-primary);\n    color: var(--text-primary);\n    font-family: 'Manrope', sans-serif;\n    font-weight: 300;\n    line-height: 1.6;\n    margin: 0;\n  }\n\n  .nav-scrolled {\n    background: rgba(0, 18, 51, 0.94);\n    backdrop-filter: blur(14px);\n    -webkit-backdrop-filter: blur(14px);\n  }\n\n  .constellation-rotate {\n    animation: slowRotate 120s linear infinite;\n    transform-origin: center;\n  }\n\n  @keyframes slowRotate {\n    to { transform: rotate(360deg); }\n  }\n\n  .hero-headline::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: var(--bg-primary);\n    transform: scaleX(1);\n    transform-origin: right;\n    transition: transform 1.2s var(--ease-expo);\n  }\n\n  .hero-headline.is-in::after {\n    transform: scaleX(0);\n  }\n\n  .glow-text {\n    color: var(--accent-1);\n    text-shadow: 0 0 40px rgba(244, 196, 48, 0.55), 0 0 80px rgba(244, 196, 48, 0.25);\n  }\n\n  .spotlight-mask {\n    -webkit-mask-image: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), black 180px, transparent 280px);\n    mask-image: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), black 180px, transparent 280px);\n  }\n\n  .word-fill {\n    color: var(--text-muted);\n    transition: color 0.5s var(--ease-expo);\n  }\n\n  .word-fill.filled {\n    color: var(--accent-1);\n    background: linear-gradient(135deg, var(--accent-1) 30%, #fff 80%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .scroll-bounce {\n    animation: bounce 2.2s ease-in-out infinite;\n  }\n\n  @keyframes bounce {\n    0%, 100% { transform: translateY(0); }\n    50% { transform: translateY(7px); }\n  }\n</style>\n<div class=\"relative overflow-x-hidden\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Nav -->\n    <nav class=\"fixed top-0 left-0 right-0 z-50 py-6 transition-all duration-400\" data-dynamic=\"true\" data-kid=\"1-1\" data-name=\"main navigation bar\" data-reason=\"classes changed on scroll by JS\" id=\"main-nav\">\n        <div class=\"max-w-[1440px] mx-auto px-[6vw] flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"navigation content container\">\n            <a class=\"nav-logo font-['Italiana'] text-[22px] tracking-[0.06em] text-[var(--text-primary)]\" data-kid=\"1-1-1-1\" data-name=\"site logo link\" href=\"#\">\n                HORIZON\n            </a>\n            <div class=\"flex items-center gap-9\" data-kid=\"1-1-1-2\" data-name=\"navigation links container\">\n                <a class=\"font-['Space+Mono'] text-[10px] tracking-[0.12em] uppercase opacity-75 hover:opacity-100 transition-opacity\" data-kid=\"1-1-1-2-1\" data-name=\"expeditions navigation link\" href=\"#routes\">\n                    EXPEDITIONS\n                </a>\n                <a class=\"font-['Space+Mono'] text-[10px] tracking-[0.12em] uppercase opacity-75 hover:opacity-100 transition-opacity\" data-kid=\"1-1-1-2-2\" data-name=\"dispatches navigation link\" href=\"#voices\">\n                    DISPATCHES\n                </a>\n                <a class=\"font-['Space+Mono'] text-[10px] tracking-[0.12em] uppercase opacity-75 hover:opacity-100 transition-opacity\" data-kid=\"1-1-1-2-3\" data-name=\"about navigation link\" href=\"#\">\n                    ABOUT\n                </a>\n                <a class=\"nav-cta font-['Space+Mono'] text-[10px] tracking-[0.12em] uppercase bg-[var(--accent-1)] text-[var(--bg-primary)] px-5 py-2 hover:bg-[#fbd36e] transition-colors\" data-kid=\"1-1-1-2-4\" data-name=\"begin expedition call-to-action\" href=\"#\">\n                    BEGIN →\n                </a>\n            </div>\n        </div>\n    </nav>\n    <!-- Hero -->\n    <section class=\"hero relative w-full h-screen min-h-[600px] flex items-center justify-end overflow-hidden bg-[var(--bg-primary)]\" data-kid=\"1-2\" data-name=\"hero section\">\n        <video autoplay=\"\" class=\"absolute inset-0 w-full h-full object-cover opacity-60\" data-kid=\"1-2-1\" data-name=\"hero background video\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/15489256/beach-sunset-canarische-eilanden-las-palmas-de-gran-canaria-ocean-15489256.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/15489256/15489256-uhd_3840_2160_30fps.mp4\">\n        </video>\n        <div class=\"absolute inset-0 bg-gradient-to-b from-[rgba(0,18,51,0.45)] via-[rgba(0,18,51,0.18)] to-[rgba(0,18,51,0.50)]\" data-kid=\"1-2-2\" data-name=\"hero overlay gradient\">\n        </div>\n        <!-- Rotating Constellation -->\n        <svg class=\"constellation absolute top-[6%] left-[4%] w-[36vw] max-w-[520px] opacity-60 pointer-events-none z-10\" data-kid=\"1-2-3\" data-name=\"rotating constellation graphic\" viewbox=\"0 0 500 400\">\n            <g class=\"constellation-rotate\">\n                <circle cx=\"100\" cy=\"100\" fill=\"white\" r=\"1.5\">\n                </circle>\n                <circle cx=\"200\" cy=\"50\" fill=\"white\" r=\"1.5\">\n                </circle>\n                <circle cx=\"250\" cy=\"150\" fill=\"var(--accent-1)\" r=\"2\">\n                </circle>\n                <circle cx=\"350\" cy=\"80\" fill=\"white\" r=\"1.5\">\n                </circle>\n                <circle cx=\"400\" cy=\"200\" fill=\"white\" r=\"1.5\">\n                </circle>\n                <line opacity=\"0.3\" stroke=\"white\" stroke-width=\"0.5\" x1=\"100\" x2=\"200\" y1=\"100\" y2=\"50\">\n                </line>\n                <line opacity=\"0.3\" stroke=\"white\" stroke-width=\"0.5\" x1=\"200\" x2=\"250\" y1=\"50\" y2=\"150\">\n                </line>\n                <line opacity=\"0.3\" stroke=\"white\" stroke-width=\"0.5\" x1=\"250\" x2=\"350\" y1=\"150\" y2=\"80\">\n                </line>\n                <line opacity=\"0.3\" stroke=\"white\" stroke-width=\"0.5\" x1=\"350\" x2=\"400\" y1=\"80\" y2=\"200\">\n                </line>\n            </g>\n        </svg>\n        <!-- Vertical Rail -->\n        <div class=\"hero-rail absolute right-0 inset-y-0 w-7 flex items-center justify-center z-30 pointer-events-none\" data-kid=\"1-2-4\" data-name=\"hero vertical rail\">\n            <span class=\"block font-['Space+Mono'] text-[9px] tracking-[0.24em] uppercase text-[var(--text-muted)] opacity-50 whitespace-nowrap rotate-90\" data-kid=\"1-2-4-1\" data-name=\"vertical rail text label\">\n                DARK SKY EXPEDITIONS · 64°N · 140°E\n            </span>\n        </div>\n        <!-- Content -->\n        <div class=\"hero-content relative z-20 text-right pr-[7vw] max-w-[54%]\" data-kid=\"1-2-5\" data-name=\"hero text content container\">\n            <div class=\"hero-eyebrow flex items-center justify-end gap-2.5 font-['Space+Mono'] text-[10px] tracking-[0.20em] uppercase text-[var(--accent-1)] mb-7\" data-kid=\"1-2-5-1\" data-name=\"hero eyebrow text\">\n                ✦ EXPEDITIONS AT THE EDGE OF THE CHARTED WORLD\n            </div>\n            <h1 class=\"hero-headline font-['Italiana'] text-[clamp(28px,3.6vw,50px)] leading-[1.02] tracking-[0.04em] mb-7 relative overflow-hidden\" data-dynamic=\"true\" data-kid=\"1-2-5-2\" data-name=\"hero headline\" data-reason=\"class added by script after timeout\">\n                Where the\n                <span class=\"glow-text\" data-kid=\"1-2-5-2-1\" data-name=\"glowing night text\">\n                    night\n                </span>\n                goes to work.\n            </h1>\n            <div class=\"hero-rule w-[60px] h-[1px] bg-[var(--accent-1)] ml-auto mb-7\" data-kid=\"1-2-5-3\" data-name=\"hero decorative line\">\n            </div>\n            <p class=\"hero-sub font-['Manrope'] text-base font-light leading-[1.68] text-white opacity-70 mb-9 max-w-[380px] ml-auto\" data-kid=\"1-2-5-4\" data-name=\"hero subheadline text\">\n                Elite wilderness expeditions shaped by darkness, silence, and the spaces between stars.\n            </p>\n            <a class=\"hero-cta inline-block bg-[var(--accent-1)] text-[var(--bg-primary)] font-['Space+Mono'] text-[11px] tracking-[0.14em] uppercase px-7 py-3.5 transition-transform hover:-translate-y-px\" data-kid=\"1-2-5-5\" data-name=\"hero primary action button\" href=\"#routes\">\n                BEGIN YOUR EXPEDITION →\n            </a>\n        </div>\n        <div class=\"scroll-indicator absolute bottom-9 left-1/2 -translate-x-1/2 z-20 opacity-50 scroll-bounce\" data-kid=\"1-2-6\" data-name=\"scroll indicator icon\">\n            <svg data-kid=\"1-2-6-1\" data-name=\"down arrow icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" viewbox=\"0 0 14 24\" width=\"14\">\n                <path d=\"M7 2v15M2 12l5 5 5-5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\">\n                </path>\n            </svg>\n        </div>\n    </section>\n    <!-- Section 1: Routes -->\n    <section class=\"routes relative bg-[var(--bg-secondary)] overflow-hidden\" data-dynamic=\"true\" data-kid=\"1-3\" data-name=\"routes section\" data-reason=\"CSS variables updated on mouse move by script\" id=\"routes\">\n        <div class=\"routes-bg-base absolute inset-0\" data-kid=\"1-3-1\" data-name=\"routes background container\">\n            <img alt=\"Aurora fjord\" class=\"w-full h-full object-cover opacity-10 grayscale-[60%]\" data-kid=\"1-3-1-1\" data-name=\"aurora fjord background image\" src=\"https://images.unsplash.com/photo-1549122752-018ceade3bf6?auto=format&w=1440&q=80\"/>\n        </div>\n        <div class=\"routes-bg-reveal absolute inset-0 spotlight-mask\" data-dynamic=\"true\" data-kid=\"1-3-2\" data-name=\"routes reveal layer container\" data-reason=\"CSS variables updated on mouse move by script\">\n            <img alt=\"Aurora fjord vivid\" class=\"w-full h-full object-cover opacity-60\" data-kid=\"1-3-2-1\" data-name=\"aurora fjord reveal image\" src=\"https://images.unsplash.com/photo-1549122752-018ceade3bf6?auto=format&w=1440&q=80\"/>\n        </div>\n        <div class=\"routes-content relative z-10 px-[6vw] py-[100px] grid grid-cols-1 md:grid-cols-2 gap-[60px] max-w-[1440px] mx-auto items-center\" data-kid=\"1-3-3\" data-name=\"routes content layout\">\n            <div data-kid=\"1-3-3-1\" data-name=\"routes text content block\">\n                <div class=\"section-eyebrow font-['Space+Mono'] text-[10px] tracking-[0.20em] uppercase text-[var(--accent-1)] mb-5\" data-kid=\"1-3-3-1-1\" data-name=\"routes section eyebrow\">\n                    THE EXPEDITIONS\n                </div>\n                <h2 class=\"routes-headline font-['Fraunces'] font-black italic text-[clamp(40px,5vw,68px)] leading-[1.04] mb-6\" data-kid=\"1-3-3-1-2\" data-name=\"routes headline\">\n                    Not a tour.\n                    <br data-kid=\"1-3-3-1-2-1\" data-name=\"line break\"/>\n                    Not a package.\n                </h2>\n                <p class=\"routes-body font-['Manrope'] text-[15px] font-light leading-[1.74] text-[var(--text-muted)] mb-9 max-w-[380px]\" data-kid=\"1-3-3-1-3\" data-name=\"routes description text\">\n                    An expedition shaped around your capacity for wonder. Three continents, one standard: the dark frontier.\n                </p>\n                <a class=\"section-link font-['Space+Mono'] text-[10px] tracking-[0.14em] uppercase text-[var(--accent-1)] hover:opacity-70 transition-opacity\" data-kid=\"1-3-3-1-4\" data-name=\"view all expeditions link\" href=\"#\">\n                    VIEW ALL EXPEDITIONS →\n                </a>\n            </div>\n            <div class=\"flex flex-col gap-0\" data-kid=\"1-3-3-2\" data-name=\"routes cards container\">\n                <div class=\"route-card flex items-center justify-between p-5 border-t border-[rgba(160,176,208,0.18)] border-l-3 border-[var(--accent-1)] cursor-pointer hover:bg-[rgba(244,196,48,0.07)] transition-colors\" data-kid=\"1-3-3-2-1\" data-name=\"northern lights route card\">\n                    <div class=\"flex flex-col gap-1\" data-kid=\"1-3-3-2-1-1\" data-name=\"northern lights card text group\">\n                        <span class=\"route-name font-['Fraunces'] font-bold italic text-xl\" data-kid=\"1-3-3-2-1-1-1\" data-name=\"northern lights route name\">\n                            Northern Lights Passage\n                        </span>\n                        <span class=\"route-region font-['Space+Mono'] text-[9px] tracking-[0.18em] uppercase text-[var(--text-muted)]\" data-kid=\"1-3-3-2-1-1-2\" data-name=\"northern lights region\">\n                            Iceland\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-[18px]\" data-kid=\"1-3-3-2-1-2\" data-name=\"northern lights details\">\n                        <span class=\"route-duration font-['Manrope'] text-xs font-light text-[var(--text-muted)]\" data-kid=\"1-3-3-2-1-2-1\" data-name=\"northern lights duration\">\n                            14 nights\n                        </span>\n                        <span class=\"route-arrow text-[var(--accent-1)] text-lg\" data-kid=\"1-3-3-2-1-2-2\" data-name=\"route arrow icon\">\n                            →\n                        </span>\n                    </div>\n                </div>\n                <div class=\"route-card flex items-center justify-between p-5 border-t border-[rgba(160,176,208,0.18)] border-l-3 border-[var(--accent-1)] cursor-pointer hover:bg-[rgba(244,196,48,0.07)] transition-colors\" data-kid=\"1-3-3-2-2\" data-name=\"atacama route card\">\n                    <div class=\"flex flex-col gap-1\" data-kid=\"1-3-3-2-2-1\" data-name=\"atacama card text group\">\n                        <span class=\"route-name font-['Fraunces'] font-bold italic text-xl\" data-kid=\"1-3-3-2-2-1-1\" data-name=\"atacama route name\">\n                            Atacama Night Trek\n                        </span>\n                        <span class=\"route-region font-['Space+Mono'] text-[9px] tracking-[0.18em] uppercase text-[var(--text-muted)]\" data-kid=\"1-3-3-2-2-1-2\" data-name=\"atacama region\">\n                            Chile\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-[18px]\" data-kid=\"1-3-3-2-2-2\" data-name=\"atacama details\">\n                        <span class=\"route-duration font-['Manrope'] text-xs font-light text-[var(--text-muted)]\" data-kid=\"1-3-3-2-2-2-1\" data-name=\"atacama duration\">\n                            9 nights\n                        </span>\n                        <span class=\"route-arrow text-[var(--accent-1)] text-lg\" data-kid=\"1-3-3-2-2-2-2\" data-name=\"route arrow icon\">\n                            →\n                        </span>\n                    </div>\n                </div>\n                <div class=\"route-card flex items-center justify-between p-5 border-t border-b border-[rgba(160,176,208,0.18)] border-l-3 border-[var(--accent-1)] cursor-pointer hover:bg-[rgba(244,196,48,0.07)] transition-colors\" data-kid=\"1-3-3-2-3\" data-name=\"namibian route card\">\n                    <div class=\"flex flex-col gap-1\" data-kid=\"1-3-3-2-3-1\" data-name=\"namibian card text group\">\n                        <span class=\"route-name font-['Fraunces'] font-bold italic text-xl\" data-kid=\"1-3-3-2-3-1-1\" data-name=\"namibian route name\">\n                            Namibian Dark Sky Reserve\n                        </span>\n                        <span class=\"route-region font-['Space+Mono'] text-[9px] tracking-[0.18em] uppercase text-[var(--text-muted)]\" data-kid=\"1-3-3-2-3-1-2\" data-name=\"namibian region\">\n                            Namibia\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-[18px]\" data-kid=\"1-3-3-2-3-2\" data-name=\"namibian details\">\n                        <span class=\"route-duration font-['Manrope'] text-xs font-light text-[var(--text-muted)]\" data-kid=\"1-3-3-2-3-2-1\" data-name=\"namibian duration\">\n                            11 nights\n                        </span>\n                        <span class=\"route-arrow text-[var(--accent-1)] text-lg\" data-kid=\"1-3-3-2-3-2-2\" data-name=\"route arrow icon\">\n                            →\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Section 2: Voices -->\n    <section class=\"voices bg-[var(--surface-mid)] py-[120px] px-[8vw] overflow-hidden\" data-kid=\"1-4\" data-name=\"voices section\" id=\"voices\">\n        <div class=\"max-w-[1100px] mx-auto\" data-kid=\"1-4-1\" data-name=\"voices content container\">\n            <h2 class=\"word-mask-headline font-['Fraunces'] font-black italic text-[clamp(44px,6vw,80px)] leading-[1.08] mb-[72px] flex flex-wrap gap-[0.2em]\" data-kid=\"1-4-1-1\" data-name=\"voice headline\">\n                <span class=\"word-fill\" data-dynamic=\"true\" data-kid=\"1-4-1-1-1\" data-name=\"they word span\" data-reason=\"class added when in viewport by observer\">\n                    They\n                </span>\n                <span class=\"word-fill\" data-dynamic=\"true\" data-kid=\"1-4-1-1-2\" data-name=\"chose word span\" data-reason=\"class added when in viewport by observer\">\n                    chose\n                </span>\n                <span class=\"word-fill\" data-dynamic=\"true\" data-kid=\"1-4-1-1-3\" data-name=\"the word span\" data-reason=\"class added when in viewport by observer\">\n                    the\n                </span>\n                <span class=\"word-fill\" data-dynamic=\"true\" data-kid=\"1-4-1-1-4\" data-name=\"dark word span\" data-reason=\"class added when in viewport by observer\">\n                    dark.\n                </span>\n            </h2>\n            <div class=\"space-y-[56px]\" data-kid=\"1-4-1-2\" data-name=\"voices testimonials list\">\n                <div class=\"voice-block max-w-[820px]\" data-kid=\"1-4-1-2-1\" data-name=\"first testimonial block\">\n                    <p class=\"font-['Fraunces'] font-bold italic text-[clamp(26px,3vw,40px)] leading-tight text-[var(--accent-1)] mb-3.5\" data-kid=\"1-4-1-2-1-1\" data-name=\"first testimonial quote\">\n                        \"The sky reminded me I was nowhere near home.\"\n                    </p>\n                    <cite class=\"font-['Space+Mono'] text-[10px] tracking-[0.12em] uppercase text-[var(--text-muted)] opacity-65\" data-kid=\"1-4-1-2-1-2\" data-name=\"first testimonial attribution\">\n                        — Mara K., Iceland Expedition 2024\n                    </cite>\n                </div>\n                <div class=\"voice-block max-w-[600px] ml-auto text-right\" data-kid=\"1-4-1-2-2\" data-name=\"second testimonial block\">\n                    <p class=\"font-['Fraunces'] font-bold italic text-[clamp(20px,2.2vw,28px)] leading-snug text-white mb-2.5\" data-kid=\"1-4-1-2-2-1\" data-name=\"second testimonial quote\">\n                        \"Fourteen nights. Zero regrets.\"\n                    </p>\n                    <cite class=\"font-['Space+Mono'] text-[10px] tracking-[0.12em] uppercase text-[var(--text-muted)] opacity-65\" data-kid=\"1-4-1-2-2-2\" data-name=\"second testimonial attribution\">\n                        — James O., Atacama Night Trek 2023\n                    </cite>\n                </div>\n                <div class=\"voice-block max-w-[460px] mx-auto text-center\" data-kid=\"1-4-1-2-3\" data-name=\"third testimonial block\">\n                    <p class=\"font-['Manrope'] font-light italic text-lg leading-relaxed text-[var(--text-muted)] mb-2\" data-kid=\"1-4-1-2-3-1\" data-name=\"third testimonial quote\">\n                        \"Every horizon crossed left us more certain of the next.\"\n                    </p>\n                    <cite class=\"font-['Space+Mono'] text-[10px] tracking-[0.12em] uppercase text-[var(--text-muted)] opacity-65\" data-kid=\"1-4-1-2-3-2\" data-name=\"third testimonial attribution\">\n                        — The Rivas family, Namibia 2024\n                    </cite>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Section 3: Night Crossings -->\n    <section class=\"crossings bg-[var(--bg-primary)] py-[120px] px-[6vw]\" data-kid=\"1-5\" data-name=\"crossings section\">\n        <div class=\"max-w-[1440px] mx-auto mb-20\" data-kid=\"1-5-1\" data-name=\"crossings header group\">\n            <div class=\"font-['Space+Mono'] text-[10px] tracking-[0.20em] uppercase text-[var(--accent-1)] mb-5\" data-kid=\"1-5-1-1\" data-name=\"field dispatches eyebrow\">\n                FIELD DISPATCHES\n            </div>\n            <h2 class=\"font-['Fraunces'] font-black italic text-[clamp(38px,5vw,64px)] leading-[1.06]\" data-kid=\"1-5-1-2\" data-name=\"crossings headline\">\n                Three crossings. One standard.\n            </h2>\n        </div>\n        <div class=\"crossing-grid max-w-[1440px] mx-auto perspective-[1500px]\" data-kid=\"1-5-2\" data-name=\"crossings grid container\">\n            <div class=\"grid grid-cols-[44fr_32fr_24fr] gap-7 items-start\" data-kid=\"1-5-2-1\" data-name=\"crossings cards list\">\n                <!-- Card 1 -->\n                <div class=\"tilt-card group translate-y-0\" data-dynamic=\"true\" data-kid=\"1-5-2-1-1\" data-name=\"first crossing card\" data-reason=\"style transformed on mouse move by script\" data-tilt=\"\">\n                    <div class=\"bg-[var(--surface-mid)] overflow-hidden\" data-kid=\"1-5-2-1-1-1\" data-name=\"first card image container\">\n                        <img alt=\"Icebreaker ship\" class=\"w-full aspect-[2/3] object-cover transition-transform duration-700 group-hover:scale-105\" data-kid=\"1-5-2-1-1-1-1\" data-name=\"antarctic break image\" src=\"https://images.unsplash.com/photo-1623602235002-8d15f7ed2496?auto=format&w=800&q=80\"/>\n                    </div>\n                    <div class=\"pt-6\" data-kid=\"1-5-2-1-1-2\" data-name=\"first card text content\">\n                        <div class=\"font-['Space+Mono'] text-[9px] tracking-[0.22em] uppercase text-[var(--accent-1)] mb-3\" data-kid=\"1-5-2-1-1-2-1\" data-name=\"first card coordinate\">\n                            64°21′S · 30°14′W\n                        </div>\n                        <h3 class=\"font-['Fraunces'] font-bold italic text-[26px] leading-[1.18] mb-3\" data-kid=\"1-5-2-1-1-2-2\" data-name=\"first card title\">\n                            The Antarctic Break\n                        </h3>\n                        <p class=\"font-['Manrope'] text-sm font-light leading-[1.72] text-[var(--text-muted)]\" data-kid=\"1-5-2-1-1-2-3\" data-name=\"first card description\">\n                            Twelve days cutting through the Weddell Sea. Silence is not the absence of sound, but the presence of everything else.\n                        </p>\n                    </div>\n                </div>\n                <!-- Card 2 -->\n                <div class=\"tilt-card mt-20 border border-[var(--accent-2)] p-10 bg-[var(--bg-secondary)]\" data-dynamic=\"true\" data-kid=\"1-5-2-1-2\" data-name=\"second crossing card\" data-reason=\"style transformed on mouse move by script\" data-tilt=\"\">\n                    <div class=\"font-['Space+Mono'] text-[9px] tracking-[0.22em] uppercase text-[var(--accent-1)] mb-3\" data-kid=\"1-5-2-1-2-1\" data-name=\"second card coordinate\">\n                        23°52′S · 69°01′W\n                    </div>\n                    <h3 class=\"font-['Fraunces'] font-bold italic text-[30px] leading-[1.18] mb-3\" data-kid=\"1-5-2-1-2-2\" data-name=\"second card title\">\n                        Atacama: Where the Sky Begins\n                    </h3>\n                    <p class=\"font-['Manrope'] text-sm font-light leading-[1.72] text-[var(--text-muted)] mb-3.5\" data-kid=\"1-5-2-1-2-3\" data-name=\"second card description paragraph one\">\n                        At 5,000 metres, you stop trying to name what you see and start listening to what the silence is saying.\n                    </p>\n                    <p class=\"font-['Manrope'] text-sm font-light leading-[1.72] text-[var(--text-muted)]\" data-kid=\"1-5-2-1-2-4\" data-name=\"second card description paragraph two\">\n                        Nine nights. No phones after sunset. Every expedition is designed to exceed the extraordinary imagination.\n                    </p>\n                </div>\n                <!-- Card 3 -->\n                <div class=\"tilt-card mt-[160px] group\" data-dynamic=\"true\" data-kid=\"1-5-2-1-3\" data-name=\"third crossing card\" data-reason=\"style transformed on mouse move by script\" data-tilt=\"\">\n                    <div class=\"bg-[var(--surface-mid)] overflow-hidden\" data-kid=\"1-5-2-1-3-1\" data-name=\"third card image container\">\n                        <img alt=\"Aurora reflection\" class=\"w-full aspect-[3/4] object-cover transition-transform duration-700 group-hover:scale-105\" data-kid=\"1-5-2-1-3-1-1\" data-name=\"aurora reflection image\" src=\"https://images.unsplash.com/photo-1759840636082-6f6bf5694d1a?auto=format&w=800&q=80\"/>\n                    </div>\n                    <div class=\"pt-6\" data-kid=\"1-5-2-1-3-2\" data-name=\"third card text content\">\n                        <div class=\"font-['Space+Mono'] text-[9px] tracking-[0.22em] uppercase text-[var(--accent-1)] mb-3\" data-kid=\"1-5-2-1-3-2-1\" data-name=\"third card coordinate\">\n                            41°50′N · 79°11′E\n                        </div>\n                        <h3 class=\"font-['Fraunces'] font-bold italic text-[26px] leading-[1.18] mb-3\" data-kid=\"1-5-2-1-3-2-2\" data-name=\"third card title\">\n                            Northern Watch\n                        </h3>\n                        <p class=\"font-['Manrope'] text-sm font-light leading-[1.72] text-[var(--text-muted)]\" data-kid=\"1-5-2-1-3-2-3\" data-name=\"third card description\">\n                            Eleven nights at high altitude. Unfiltered sky above, silence below. The stars don't just shine; they vibrate.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Footer -->\n    <footer class=\"pt-0 px-[6vw] pb-[60px] bg-[var(--bg-primary)]\" data-kid=\"1-6\" data-name=\"footer bar\">\n        <div class=\"h-[1px] bg-gradient-to-r from-transparent via-[var(--accent-1)] to-transparent mb-20\" data-kid=\"1-6-1\" data-name=\"footer decorative line\">\n        </div>\n        <div class=\"max-w-[1440px] mx-auto grid grid-cols-1 md:grid-cols-[1.8fr_1.6fr_1.3fr] gap-[60px] items-start\" data-kid=\"1-6-2\" data-name=\"footer content grid\">\n            <div data-kid=\"1-6-2-1\" data-name=\"footer logo and branding\">\n                <a class=\"block font-['Italiana'] text-[clamp(52px,7vw,100px)] leading-[0.95] tracking-[0.03em] mb-4\" data-kid=\"1-6-2-1-1\" data-name=\"footer site title link\" href=\"#\">\n                    Horizon\n                </a>\n                <p class=\"font-['Manrope'] text-[17px] font-light italic text-[var(--text-muted)]\" data-kid=\"1-6-2-1-2\" data-name=\"footer slogan text\">\n                    Where the night goes to work.\n                </p>\n            </div>\n            <div class=\"grid grid-cols-2 gap-10\" data-kid=\"1-6-2-2\" data-name=\"footer links navigation\">\n                <div data-kid=\"1-6-2-2-1\" data-name=\"footer expeditions column\">\n                    <div class=\"font-['Space+Mono'] text-[9px] tracking-[0.20em] uppercase text-[var(--accent-1)] mb-5\" data-kid=\"1-6-2-2-1-1\" data-name=\"footer expeditions column title\">\n                        EXPEDITIONS\n                    </div>\n                    <ul class=\"flex flex-col gap-3 font-['Manrope'] text-sm font-light opacity-80\" data-kid=\"1-6-2-2-1-2\" data-name=\"footer expeditions list\">\n                        <li data-kid=\"1-6-2-2-1-2-1\" data-name=\"northern lights link item\">\n                            <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"1-6-2-2-1-2-1-1\" data-name=\"northern lights link\" href=\"#\">\n                                Northern Lights Passage\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-1-2-2\" data-name=\"atacama trek link item\">\n                            <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"1-6-2-2-1-2-2-1\" data-name=\"atacama trek link\" href=\"#\">\n                                Atacama Night Trek\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-1-2-3\" data-name=\"namibian reserve link item\">\n                            <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"1-6-2-2-1-2-3-1\" data-name=\"namibian reserve link\" href=\"#\">\n                                Namibian Dark Sky Reserve\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-1-2-4\" data-name=\"tian shan watch link item\">\n                            <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"1-6-2-2-1-2-4-1\" data-name=\"tian shan watch link\" href=\"#\">\n                                Tian Shan Night Watch\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-1-2-5\" data-name=\"view all link item\">\n                            <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"1-6-2-2-1-2-5-1\" data-name=\"view all link\" href=\"#\">\n                                View All\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-6-2-2-2\" data-name=\"footer company column\">\n                    <div class=\"font-['Space+Mono'] text-[9px] tracking-[0.20em] uppercase text-[var(--accent-1)] mb-5\" data-kid=\"1-6-2-2-2-1\" data-name=\"footer company column title\">\n                        COMPANY\n                    </div>\n                    <ul class=\"flex flex-col gap-3 font-['Manrope'] text-sm font-light opacity-80\" data-kid=\"1-6-2-2-2-2\" data-name=\"footer company list\">\n                        <li data-kid=\"1-6-2-2-2-2-1\" data-name=\"about horizon link item\">\n                            <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"1-6-2-2-2-2-1-1\" data-name=\"about horizon link\" href=\"#\">\n                                About Horizon\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-2-2-2\" data-name=\"dispatches link item\">\n                            <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"1-6-2-2-2-2-2-1\" data-name=\"dispatches link\" href=\"#\">\n                                Dispatches\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-2-2-3\" data-name=\"field notes link item\">\n                            <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"1-6-2-2-2-2-3-1\" data-name=\"field notes link\" href=\"#\">\n                                Field Notes\n                            </a>\n                        </li>\n                        <li data-kid=\"1-6-2-2-2-2-4\" data-name=\"contact link item\">\n                            <a class=\"hover:opacity-100 transition-opacity\" data-kid=\"1-6-2-2-2-2-4-1\" data-name=\"contact link\" href=\"#\">\n                                Contact\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"border border-[var(--accent-1)] p-[36px_28px]\" data-kid=\"1-6-2-3\" data-name=\"footer cta block\">\n                <p class=\"font-['Fraunces'] font-bold italic text-xl leading-[1.48] mb-6\" data-kid=\"1-6-2-3-1\" data-name=\"footer cta headline\">\n                    Ready to go somewhere maps don't show?\n                </p>\n                <a class=\"inline-block bg-[var(--accent-1)] text-[var(--bg-primary)] font-['Space+Mono'] text-[10px] tracking-[0.12em] uppercase px-5 py-3 hover:bg-[#fbd36e] transition-colors\" data-kid=\"1-6-2-3-2\" data-name=\"footer cta link\" href=\"#\">\n                    BEGIN AN EXPEDITION →\n                </a>\n            </div>\n        </div>\n        <div class=\"max-w-[1440px] mx-auto mt-20 pt-6 border-t border-[rgba(160,176,208,0.1)] flex justify-between items-center text-[10px] font-['Space+Mono'] text-[var(--text-muted)] opacity-50 uppercase tracking-[0.1em]\" data-kid=\"1-6-3\" data-name=\"footer copyright row\">\n            <span data-kid=\"1-6-3-1\" data-name=\"copyright text\">\n                © 2025 Horizon Expeditions\n            </span>\n            <span data-kid=\"1-6-3-2\" data-name=\"site stats text\">\n                Est. 2012 · 2,300+ Crossings Guided\n            </span>\n        </div>\n    </footer>\n</div>\n<script>\n    // Nav transparency\n  window.addEventListener('scroll', () => {\n    const nav = document.getElementById('main-nav');\n    if (window.scrollY > 50) {\n      nav.classList.add('nav-scrolled');\n      nav.classList.remove('py-6');\n      nav.classList.add('py-4');\n    } else {\n      nav.classList.remove('nav-scrolled');\n      nav.classList.add('py-6');\n      nav.classList.remove('py-4');\n    }\n  });\n\n  // Hero reveal\n  const headline = document.querySelector('.hero-headline');\n  setTimeout(() => headline.classList.add('is-in'), 500);\n\n  // Section 1 Spotlight\n  const routesSec = document.querySelector('#routes');\n  routesSec.addEventListener('mousemove', (e) => {\n    const rect = routesSec.getBoundingClientRect();\n    const x = ((e.clientX - rect.left) / rect.width) * 100;\n    const y = ((e.clientY - rect.top) / rect.height) * 100;\n    routesSec.style.setProperty('--mx', x + '%');\n    routesSec.style.setProperty('--my', y + '%');\n  });\n\n  // Section 2 Word Fill\n  const words = document.querySelectorAll('.word-fill');\n  const observer = new IntersectionObserver((entries) => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        entry.target.classList.add('filled');\n      }\n    });\n  }, { threshold: 0.5 });\n  words.forEach(w => observer.observe(w));\n\n  // Section 3 Tilt\n  const cards = document.querySelectorAll('[data-tilt]');\n  cards.forEach(card => {\n    card.addEventListener('mousemove', (e) => {\n      const rect = card.getBoundingClientRect();\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n      const centerX = rect.width / 2;\n      const centerY = rect.height / 2;\n      const rotateX = (y - centerY) / 20;\n      const rotateY = (centerX - x) / 20;\n      card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;\n    });\n    card.addEventListener('mouseleave', () => {\n      card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;\n    });\n  });\n</script>\n",
